// ─────────────────────────────────────────────────────────────────────────────
// OrderHub Enterprise — Prisma Schema v4 (Phase F)
// Multi-tenant omnichannel restaurant commerce platform
//
// Design principles:
//  1. tenantId is ALWAYS denormalised on write-heavy tables to avoid JOINs
//     at query time. The application enforces tenant isolation at the service
//     layer; RLS can be added at the Postgres level in a future phase.
//  2. Soft-delete (deletedAt) is used only for configuration entities that
//     operators manage (brands, locations, menus, printers, integrations).
//     Transactional records (orders, webhooks, print jobs, audit logs, payments,
//     ledger entries) are NEVER soft-deleted — they are archived per retention policy.
//  3. Cascade rules are explicit on every FK:
//       - Cascade: child record has no independent identity (e.g. OrderItem)
//       - Restrict: FK prevents accidental parent deletion (e.g. Order→Tenant)
//       - SetNull: FK becomes nullable when parent removed (e.g. PrintJob→Printer)
//  4. All timeline/audit columns are written ONCE; updatedAt is omitted from
//     immutable records to make immutability explicit.
//  5. Partitioning preparation: orders, payments, and stock_movements are keyed
//     (tenantId, createdAt) for future RANGE partitioning.
//  6. Ledger is append-only and double-entry ready: every payment creates paired
//     LedgerEntry rows (debit + credit), enabling accounting reconciliation.
//  7. Inventory deduction is eventual: StockMovement rows are written by the
//     worker after order acceptance, not inline in the API path.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["fullTextSearch", "metrics"]
  // Generate query engine for Alpine+OpenSSL (Render/Docker) alongside the native dev binary.
  // Without this, Prisma detects "linux-musl-openssl-3.0.x" at runtime but only finds
  // the "linux-musl" engine built in the builder stage (no OpenSSL present there).
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // shadowDatabaseUrl only needed for `prisma migrate dev` (local only).
  // Set SHADOW_DATABASE_URL in your local .env if running migrate dev.
}

// ── Tenant (Organisation) ─────────────────────────────────────────────────────
model Tenant {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  plan     TenantPlan   @default(STARTER)
  status   TenantStatus @default(ACTIVE)
  settings Json         @default("{}")
  metadata Json         @default("{}")

  brands                Brand[]
  users                 User[]
  apiKeys               ApiKey[]
  orders                Order[]
  printJobs             PrintJob[]
  customers             Customer[]
  promoCodes            PromoCode[]
  marketingCampaigns    MarketingCampaign[]
  drivers               Driver[]
  suppliers             Supplier[]
  ipAllowlists          IpAllowlist[]
  connectAccount        StripeConnectAccount[]
  branding              TenantBranding?
  subscription          TenantSubscription?
  merchantSubscriptions MerchantSubscription[]
  invitations           Invitation[]
  printerStations       PrinterStation[]
  printAgents           PrintAgent[]
  wallets               Wallet[]
  contractTemplates     ContractTemplate[]
  contracts             Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

// ── User ──────────────────────────────────────────────────────────────────────
model User {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String    @unique
  password    String?
  firstName   String
  lastName    String
  avatarUrl   String?
  role        UserRole  @default(VIEWER)
  permissions String[]  @default([])
  isActive    Boolean   @default(true)
  isVerified  Boolean   @default(false)
  lastLoginAt DateTime?

  refreshTokens  RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts  OAuthAccount[]
  auditLogs      AuditLog[]
  mfaConfig      MfaConfig?
  deviceSessions DeviceSession[]
  deviceTokens   DeviceToken[]

  // Phase AR — Team Roles. Per-user scoping to a subset of the
  // tenant's locations / brands.
  locations       UserLocation[]
  brands          UserBrand[]
  invitationsSent Invitation[]   @relation("InvitationInvitedBy")
  leadsSubmitted  Lead[]         @relation("LeadSubmittedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, isActive])
  @@map("users")
}

// ── UserLocation ──────────────────────────────────────────────────────────
// Phase AR. Many-to-many join between User and Location. A user can
// only access settings/data for locations they're attached to here
// (PLATFORM_ADMIN bypasses, treated as if attached to everything).
model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@map("user_locations")
}

// ── UserBrand ────────────────────────────────────────────────────────────
// Phase AR. Brands a user can manage. Usually a subset of the brands
// available at their assigned locations, but tracked separately so an
// operator can scope (e.g. "only the wings brand at this multi-brand
// site").
model UserBrand {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, brandId])
  @@index([userId])
  @@index([brandId])
  @@map("user_brands")
}

// ── Invitation ───────────────────────────────────────────────────────────
// Phase AR. Pending invitations sent by email. acceptedAt flips when
// the invited person hits the accept link and creates an account.
// cancelledAt flips if the inviter revokes. Tokens are single-use
// (we look the row up by token, then require acceptedAt == null).
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole
  locationIds String[]  @default([])
  brandIds    String[]  @default([])
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?
  invitedById String?
  invitedBy   User?     @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, acceptedAt])
  @@map("invitations")
}

// ── Lead ────────────────────────────────────────────────────────────────
// Phase AR. Surface for two contact-form flows: the no-access screen
// (shown to a freshly-created user with no location assignments yet)
// and the marketing site contact form. Surfaced to PLATFORM_ADMIN +
// ONBOARDING_AGENT at /dashboard/leads so the team can follow up.
model Lead {
  id                String     @id @default(cuid())
  firstName         String
  lastName          String
  email             String
  phone             String?
  country           String?
  companyName       String?
  numberOfLocations String?
  hearAboutUs       String?
  message           String?
  source            LeadSource @default(NO_ACCESS_SCREEN)
  status            LeadStatus @default(NEW)
  submittedByUserId String?
  submittedBy       User?      @relation("LeadSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LeadSource {
  NO_ACCESS_SCREEN
  MARKETING_SITE
  OTHER
}

// ── CustomerAccount ──────────────────────────────────────────────────────
//
// Phase AP-AUTH — Customer-facing AUTH accounts for the public storefront.
// Kept SEPARATE from:
//   1. User (staff/admin auth) — so customers cannot inherit dashboard
//      permissions and JWT audiences never overlap.
//   2. Customer (CRM record, declared below at line ~920) — that model
//      is tenant-scoped and holds order history / loyalty / addresses
//      for a specific restaurant. A single CustomerAccount can be linked
//      to many Customer rows (one per restaurant they've ordered from)
//      once we wire the FK in a follow-up; for now they live independently.
//
// Auth methods supported:
//   • Email + password (requires email confirmation)
//   • Google OAuth (Google already verifies the email — no extra step)
//
// emailVerificationToken is a one-use random string stored on the row so
// /order/[slug]/auth/confirm?token=... can flip isVerified without
// needing a separate VerificationToken table. NULL once verified.
model CustomerAccount {
  id                     String    @id @default(cuid())
  email                  String    @unique
  password               String? // null for Google-only signups
  firstName              String
  lastName               String
  phone                  String?
  googleId               String?   @unique
  avatarUrl              String?
  isVerified             Boolean   @default(false)
  emailVerificationToken String? // set during signup, cleared on verify
  marketingOptIn         Boolean   @default(false)
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  orders Order[] // Phase AP-5 — back-relation for "My Orders"

  @@index([email])
  @@index([googleId])
  @@map("customer_accounts")
}

// ── RefreshToken ──────────────────────────────────────────────────────────────
/// A one-time link emailed to someone who has forgotten their password.
///
/// Only the HASH of the token is stored, exactly as with RefreshToken: our
/// database is the thing most likely to leak, and a stolen table of raw reset
/// tokens is a stolen table of accounts. The emailed half exists nowhere on
/// our side.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  /// Set the moment it is spent — these are single use, so a link forwarded
  /// on or left sitting in a mailbox can't be replayed.
  usedAt    DateTime?
  /// Kept for abuse investigation, never for validation.
  requestedIp String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── OAuthAccount ──────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?
  rawProfile        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ── ApiKey ────────────────────────────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("api_keys")
}

// ── AuditLog ──────────────────────────────────────────────────────────────────
model AuditLog {
  id         String  @id @default(cuid())
  tenantId   String
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  event      String
  resource   String?
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  meta       Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
  @@index([userId])
  @@index([event])
  @@map("audit_logs")
}

// ── Brand ─────────────────────────────────────────────────────────────────────
model Brand {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  logoUrl   String?
  settings  Json      @default("{}")
  metadata  Json      @default("{}")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  // Phase AN — descriptive fields + "virtual brand" scoping. When
  // primaryLocationId is set, this brand lives at exactly that location
  // (ghost-kitchen model). When null the brand is a franchise parent
  // and Location.brandId is the inverse relation.
  description       String?
  cuisine           String?
  isSuspended       Boolean @default(false)
  primaryLocationId String?

  // Items the operator has pinned as "Top sellers" on the storefront —
  // shown above every category, Glovo-style. Bare MenuItem ids rather than a
  // relation: the list is a merchandising choice, not a catalogue fact, and
  // an item that later leaves the menu should just stop appearing rather
  // than block its own deletion. Order is the display order.
  topSellerItemIds String[] @default([])

  // Phase AS-6 — brand-level public storefront. Mirrors the per-location
  // pattern (Location.onlineOrderingSlug / directOrderingConfig) so a
  // virtual brand running out of a shared kitchen can have its own
  // customer-facing URL — /brand/<slug> — separate from the location
  // page. The brand reuses its primary location's address/phone/postcode
  // (no need to duplicate them); `about` is free-form marketing copy
  // shown on the storefront header.
  onlineOrderingSlug    String? @unique
  directOrderingEnabled Boolean @default(false)
  about                 String?

  // Phase AW — customer-facing storefront identity. Lives on the brand
  // (not the location) so a single kitchen running three virtual brands
  // can publish three distinct storefronts, each with its own address /
  // phone / custom domain / Stripe Connect account / receipt header.
  // The Location keeps its own structured address for ops (where the
  // kitchen actually is) — these are what the customer sees on the
  // online ordering page and the printed receipt.
  phone                     String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  postcode                  String?
  country                   String   @default("GB")
  customDomain              String?
  customDomainStatus        String   @default("not_configured") // not_configured | pending | verified | failed
  stripeConnectedAccountId  String?
  /// Tap's destination id for this brand — where its share of a split charge
  /// settles. The Gulf equivalent of stripeConnectedAccountId, and like it,
  /// a charge cannot be taken for the brand without one.
  tapDestinationId          String?
  /// Tap's business id for the brand, from the marketplace Business API.
  /// Kept alongside the destination id because they are different things and
  /// only the destination one is used on a charge.
  tapBusinessId             String?
  applicationFeeFixedAmount Decimal? @db.Decimal(10, 2)
  applicationFeePercentage  Decimal? @db.Decimal(5, 2)
  applicationFeeMode        String   @default("none") // none | fixed_only | percentage_only | fixed_and_percentage

  // Phase AW — DirectOrderingConfig now keys off the brand, not the
  // location. One config per brand drives that brand's storefront.
  directOrderingConfig DirectOrderingConfig?

  // Phase AW-16 — brand-level opening hours, base prep time, and
  // busy-mode extra prep. Operators set these on the brand (not the
  // location) so each virtual brand running out of one kitchen can
  // run on its own schedule. The Publish Hours button in the menu
  // section pushes this state to HubRise (PATCH /v1/locations/:id
  // { opening_hours, preparation_time }). Storefront + POS already
  // overlay brand-first when a brand is pinned (see AW-2 storefront
  // resolver). When null, callers fall back to the underlying
  // Location's columns for backwards compatibility.
  openingHours      Json @default("{}")
  prepTime          Int?
  busyExtraPrepTime Int?

  locations           Location[]
  menus               Menu[]
  modifierGroups      ModifierGroup[]
  orders              Order[]
  mealDeals           MealDeal[]
  upsellGroups        UpsellGroup[]
  platformConnections BrandPlatformConnection[]
  userBrands          UserBrand[]
  marketingCampaigns  MarketingCampaign[]
  deliveryZones       DeliveryZone[]
  // Phase BF — per-channel "which menu's variant prices this channel"
  // (standing setting, set once in the brand's Channels tab).
  channelSources      BrandChannelSource[]
  signageDisplays     SignageDisplay[]

  // Phase AS-1 — fallback station for items at this brand when no
  // more-specific routing rule fires.
  defaultStationId String?
  defaultStation   PrinterStation? @relation("BrandDefaultStation", fields: [defaultStationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([primaryLocationId])
  @@map("brands")
}

// ── Location ──────────────────────────────────────────────────────────────────
model Location {
  id          String    @id @default(cuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  externalRef String?
  address     Json
  phone       String?
  timezone    String    @default("Europe/London")
  isActive    Boolean   @default(true)
  settings    Json      @default("{}")
  metadata    Json      @default("{}")
  deletedAt   DateTime?

  integrations         Integration[]
  orders               Order[]
  printers             Printer[]
  printerStations      PrinterStation[]
  printAgents          PrintAgent[]
  kdsScreens           KdsScreen[]
  signageDisplays      SignageDisplay[]
  tables               Table[]
  tableReservations    TableReservation[]
  kioskDevices         KioskDevice[]
  deliveryZones        DeliveryZone[]
  paymentConfig        LocationPaymentConfig?
  userLocations        UserLocation[]
  platformConnections  BrandPlatformConnection[]
  directOrderingConfig DirectOrderingConfig?
  channelPauses        ChannelPause[]
  merchantSubscription MerchantSubscription?
  contracts            Contract[]
  menuAssignments      MenuChannelAssignment[]
  itemChannelSnoozes   MenuItemChannelAvailability[]
  homeDrivers          Driver[]                      @relation("DriverHomeLocation")

  // Phase AS-1 — print routing defaults.
  //   defaultKitchenStation — every kitchen ticket that doesn't match
  //     a more-specific rule lands here.
  //   receiptPrinter        — customer receipts.
  //   dispatchPrinter       — driver / dispatch slips.
  defaultKitchenStationId String?
  defaultKitchenStation   PrinterStation? @relation("LocationDefaultKitchenStation", fields: [defaultKitchenStationId], references: [id], onDelete: SetNull)
  receiptPrinterId        String?
  receiptPrinter          Printer?        @relation("LocationReceiptPrinter", fields: [receiptPrinterId], references: [id], onDelete: SetNull)
  dispatchPrinterId       String?
  dispatchPrinter         Printer?        @relation("LocationDispatchPrinter", fields: [dispatchPrinterId], references: [id], onDelete: SetNull)

  // Phase AN — structured address columns (mirror of the address JSON
  // for query/index). Country defaults to GB.
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  country      String  @default("GB")

  // Trading currency for this shop. Lives on the LOCATION, not on the brand
  // and not on a global setting: a brand can trade in two countries, but a
  // shop has one till, one bank account and one currency. Backfilled from
  // `country` — see currencyForCountry in @orderhub/shared, which is also
  // what the "Add location" form uses to pick a default.
  currency     String  @default("GBP")
  about        String?
  logoUrl      String?

  // Phase AN — online ordering presentation
  customDomain       String?
  customDomainStatus String  @default("not_configured") // not_configured | pending | verified | failed
  onlineOrderingSlug String? @unique

  // Phase AU — HubRise integration. Per-location because HubRise
  // access tokens are generated against a specific HubRise location
  // (each shop registers its own callback URL + token outside our app).
  //
  // We deliberately don't store the raw token here. The operator
  // pastes it into the Location settings form; the API hands it to the
  // Secrets Vault (AES-256-GCM, master key only in env) and writes
  // back the secret id below. Reads decrypt on the fly inside the
  // HubRise client and never log the plaintext.
  //
  // hubriseCatalogId is the menu the location syncs against — pasted
  // by the operator alongside the token. Not sensitive on its own so
  // it lives in plaintext for fast `WHERE` filtering when reconciling.
  hubriseCredentials Json? // encrypted envelope { accessToken } via CredentialEncryptionService
  hubriseCatalogId   String?
  // HubRise's own location id — distinct from our internal id. Needed
  // for catalog publish, order status PATCH, inventory 86, and
  // pause/resume calls. Auto-populated by the OAuth callback; can
  // also be pasted manually for operators who got their token via
  // the curl flow.
  hubriseLocationId  String?
  hubriseConnectedAt DateTime?

  // Phase BH — Stuart last-mile courier config (per location).
  stuartConfig     StuartConfig?
  // Phase BI — Uber Direct courier config (per location).
  uberDirectConfig UberDirectConfig?

  // Phase AN — Stripe Connect + application fee config
  stripeConnectedAccountId  String?
  applicationFeeFixedAmount Decimal? @db.Decimal(10, 2)
  applicationFeePercentage  Decimal? @db.Decimal(5, 2)
  applicationFeeMode        String   @default("none") // none | fixed_only | percentage_only | fixed_and_percentage

  // ── POS Stripe settings ────────────────────────────────────────────────
  // Dedicated Stripe Connect account + application fee for POS "Payment link"
  // charges at THIS location. When posStripeAccountId is set it OVERRIDES the
  // brand/location resolution for payment links (which otherwise prefer the
  // brand account) — so a shop's card links always land on its own Stripe
  // account with its own platform fee. Blank = fall back to the normal
  // resolveConnectAccount cascade. Fee = percent of order total + a fixed
  // pence amount, both optional (0/blank = no platform fee).
  // NOTE ON NAMING: these three drive PAYMENT LINKS only — nothing else in
  // the codebase reads them. The "pos" prefix is historical (they arrived
  // with the POS payment-link feature) and the dashboard now labels this
  // section "Payment link settings" to match what it actually does. The
  // columns are deliberately NOT renamed: this location row is written by
  // raw SQL precisely because a stale deployed Prisma client can lag the
  // schema, and a column rename is the worst thing to put in front of that.
  posStripeAccountId          String?
  posApplicationFeePercent    Decimal? @db.Decimal(5, 2)
  posApplicationFeeFixedMinor Int?

  // ── POS terminal fee (card-present) ────────────────────────────────────
  // Platform fee for charges taken on a card reader AT this location —
  // S700 / WisePOS, WisePad 3, and Tap to Pay on iPhone or Android.
  // Deliberately per-location, not per-brand: a shop's card-present takings
  // are the shop's, and one brand can trade from several shops.
  // NULL = inherit the existing brand/location applicationFee* resolution,
  // so nothing changes until an operator sets this. An explicit 0 means
  // "charge nothing on terminal payments", which is a real choice and
  // distinct from leaving it unset.
  posTerminalApplicationFeePercent    Decimal? @db.Decimal(5, 2)
  posTerminalApplicationFeeFixedMinor Int?

  // Phase AN — operational status string (active | suspended | closed)
  // kept alongside isActive/isPaused for finer-grained UI presentation.
  status String @default("active")

  // Phase AP-5 — public Google Business Profile review URL. Surfaced on
  // the customer "My Orders" history card via a "Leave Google review"
  // button after a delivered/collected order. Optional; the button is
  // hidden when null.
  googleReviewUrl String?

  // Phase AN — structured busy-mode metadata. The boolean below stays
  // (used by AM); this carries reason + until + affected platforms.
  busyModeJson Json @default("{}")

  shopCode   String? @unique
  // Bearer token presented by the legacy Flutter printer app as
  // `X-Print-Token` when polling /v1/printer-jobs. Nullable so existing
  // locations stay backwards-compatible; once set, the new endpoint
  // requires a match. Rotated via the locations admin UI.
  printToken String? @unique

  // Online ordering
  slug              String? @unique
  openingHours      Json    @default("[]")
  deliveryConfig    Json    @default("{}")
  // Phase AZ — location-level prep time (base + busy-mode extra), mirroring
  // the brand fields. HubRise + WhatsApp fall back to these when the brand
  // hasn't set its own hours/prep.
  prepTime          Int?
  busyExtraPrepTime Int?
  onboardingStep    Int     @default(0)

  // ── Go-live lifecycle ─────────────────────────────────
  goLiveStatus    LocationGoLiveStatus @default(DRAFT)
  lastTestOrderAt DateTime?
  lastTestPrintAt DateTime?

  // ── Store Operations ──────────────────────────────────
  isOpen          Boolean   @default(true)
  isPaused        Boolean   @default(false)
  pauseUntil      DateTime?
  busyMode        Boolean   @default(false)
  currentPrepTime Int       @default(20)
  throttleLimit   Int?
  storeStatusNote String?

  /// Geocoded from the shop's own postcode, once. Radius delivery fees measure
  /// from here; without it a radius zone set can't quote at all.
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, deletedAt])
  @@map("locations")
}

// ── BrandPlatformConnection (Phase AN) ────────────────────────────────────────
// Per (brand, location, platform) connection record. Today the columns
// are placeholders the UI renders against — the actual OAuth / API
// connection flow per platform (Just Eat, Uber Eats, Deliveroo,
// HubRise, Stuart, Uber Direct) ships in a later phase.
model BrandPlatformConnection {
  id              String    @id @default(cuid())
  tenantId        String
  brandId         String
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locationId      String
  location        Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  platform        String // JUST_EAT | UBER_EATS | DELIVEROO | HUBRISE | STUART | UBER_DIRECT
  status          String    @default("not_connected") // not_connected | pending | connected | suspended | error
  externalStoreId String?
  externalBrandId String?
  integrationId   String?
  lastSyncAt      DateTime?
  lastWebhookAt   DateTime?
  lastError       String?
  metadata        Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, locationId, platform])
  @@index([tenantId])
  @@index([locationId])
  @@map("brand_platform_connections")
}

// ── Integration ───────────────────────────────────────────────────────────────
model Integration {
  id           String              @id @default(cuid())
  tenantId     String
  locationId   String
  location     Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  platform     IntegrationPlatform
  status       IntegrationStatus   @default(INACTIVE)
  credentials  Json
  settings     Json                @default("{}")
  webhookUrl   String?
  syncMetadata Json                @default("{}")
  lastSyncAt   DateTime?
  lastErrorAt  DateTime?
  lastError    String?
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, platform])
  @@index([tenantId])
  @@index([tenantId, platform])
  @@index([locationId])
  @@index([locationId, status])
  @@map("integrations")
}

// ── Menu / Category / Item ────────────────────────────────────────────────────
model Menu {
  id          String     @id @default(cuid())
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  // Phase AK — Base44 menus are location-scoped. Existing Menu rows were
  // brand-scoped (one menu shared across all locations of the brand). The
  // new column is nullable so existing rows keep working; new menus
  // created via the Menu Manager always have locationId set.
  locationId  String?
  name        String
  description String?
  // Base44 menu_type: DELIVERY | DELIVERY_AND_PICKUP. Affects visibility
  // on the customer-facing storefront.
  menuType    MenuType   @default(DELIVERY_AND_PICKUP)
  // Hero images shown on the storefront. All optional URLs hosted on
  // wherever the operator uploads (R2 / Cloudinary later).
  bannerImage String?
  heroImage   String?
  logoImage   String?
  status      MenuStatus @default(DRAFT)
  isActive    Boolean    @default(true)
  deletedAt   DateTime?

  // ── Import / sync ──────────────────────────────────────────────────────
  // Per-platform import state. importLock prevents two concurrent imports
  // from racing on the same menu. importStatus surfaces the result to the
  // Menu Manager UI. Reset in finally{} blocks even when the import throws.
  importStatus               MenuImportStatus @default(IDLE)
  importLock                 Boolean          @default(false)
  importedAt                 DateTime?
  // Incremented on every successful import so the UI can show "version 3"
  // and downstream caches know to bust.
  syncVersion                Int              @default(0)
  // The raw response we got back from the platform. Stored for debugging
  // failed imports and for replay during a backfill.
  rawImportPayload           Json             @default("{}")
  // Whatever menu-level metadata the platform sent (e.g. menu name, type).
  menuData                   Json             @default("{}")
  // Two link tables flattened to JSON so import + render stays cheap.
  // productModifierGroupLinks: [{product_id, modifier_group_id, ...}]
  // modifierGroupModifierLinks: [{modifier_group_id, modifier_id, ...}]
  productModifierGroupLinks  Json             @default("[]")
  modifierGroupModifierLinks Json             @default("[]")

  // ── External platform refs ─────────────────────────────────────────────
  // Source / dedup keys used by import. platformSource = uber / deliveroo /
  // hubrise. externalId is the platform's own menu id; externalParentId is
  // the platform's parent (e.g. brand id for Deliveroo).
  platformSource   String?
  externalId       String?
  externalParentId String?
  lastSyncedAt     DateTime?
  syncStatus       String?
  // Base64(JSON(rawImportPayload)).slice(0,120) — used for fast diff so a
  // re-import of an unchanged menu can short-circuit.
  syncHash         String?

  // ── Publish targets ────────────────────────────────────────────────────
  // Slugs of platforms this menu has been pushed to (e.g. ["ubereats_uk",
  // "deliveroo_uk"]). Distinct from importStatus — these are outbound.
  publishedTo     String[]  @default([])
  lastPublishedAt DateTime?

  // ── Auto-schedule ──────────────────────────────────────────────────────
  // When true, a scheduled worker activates / deactivates the menu based
  // on autoSchedule { active_from, active_until, active_days, brand_id,
  // platform_ids, include_online_ordering }.
  autoScheduleEnabled Boolean @default(false)
  autoSchedule        Json    @default("{}")

  // Pricing variants — named price lists on this menu (channel presets
  // like Uber Eats/Deliveroo + custom ones). Shape: [{ ref, name,
  // channelKey? }]. Per-variant prices live as overrides on each item
  // (platformPricingOverrides), SKU (productSkus[].priceOverrides) and
  // modifier option (platformPricingOverrides), keyed by variant ref.
  // Published to HubRise as data.variants[] + price_overrides[].
  pricingVariants Json @default("[]")

  categories       MenuCategory[]
  versions         MenuVersion[]
  assignments      MenuChannelAssignment[]
  // Brands that point one of their channels' pricing at THIS menu (Phase BF
  // — this is the "Variant menu" other brands' Uber Eats/Deliveroo/
  // WhatsApp/Online channels borrow pricing from).
  channelSourceFor BrandChannelSource[]

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, status])
  @@index([locationId])
  @@index([locationId, isActive])
  @@index([platformSource, externalId])
  @@map("menus")
}

// Phase BA — serving assignments. One row = "menu M serves (location,
// channel, brand)". Upsert on the unique key gives REPLACE semantics
// (publishing a menu to a slot swaps out whichever menu held it), and a
// menu can hold many rows — many locations and channels — simultaneously,
// so publishing to a new location never removes it from a previous one.
// Menu.locationId demotes to "home location" (creation/import origin);
// these rows are the serving truth. brandId is denormalised from
// menu.brandId at publish time so the unique index has no NULL-distinct
// hole (multi-brand kitchens serve several brand storefronts per location).
model MenuChannelAssignment {
  id          String   @id @default(cuid())
  tenantId    String?
  menuId      String
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  brandId     String
  // ONLINE | POS | WHATSAPP | HUBRISE | UBER_EATS | DELIVEROO | JUST_EAT —
  // same free-form channel strings as Menu.publishedTo.
  channel     String
  publishedAt DateTime @default(now())
  createdBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, channel, brandId])
  @@index([menuId])
  @@index([locationId, channel])
  @@map("menu_channel_assignments")
}

// Phase BF — variant-menu publish for direct channels. Standing per-(brand,
// channel) setting: "this brand's Uber Eats/Deliveroo/WhatsApp/Online
// pricing comes from THIS menu's variant for this brand+channel." Mirrors
// how HubRise already works — a variant is already tagged with its own
// brandId + channelKey (brandChannelRef), so once a source menu is picked
// here the correct variant is found automatically; no separate "pick a
// variant" step, and no re-selection needed on every future publish. Set
// once in the brand's Channels settings; every publish to that channel for
// that brand resolves from it from then on, regardless of which menu is
// actually being published.
model BrandChannelSource {
  id           String @id @default(cuid())
  brandId      String
  brand        Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  // ONLINE | WHATSAPP | JUST_EAT | UBER_EATS | DELIVEROO
  channel      String
  sourceMenuId String
  sourceMenu   Menu   @relation(fields: [sourceMenuId], references: [id], onDelete: Cascade)
  // The operator picks this explicitly from the source menu's
  // pricingVariants (e.g. "monster burgerz — Deliveroo") — not derived.
  // Publish for this channel/brand then does BOTH: prices every item from
  // this variant's overrides, AND restricts the published item set to only
  // items belonging to this variant's own brand — the channel sees ONLY
  // that brand's items/prices, nothing else, matching how HubRise's
  // restrictions.variant_refs already scopes a shared catalog per brand.
  variantRef   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, channel])
  @@index([sourceMenuId])
  @@map("brand_channel_sources")
}

model MenuCategory {
  id                 String   @id @default(cuid())
  menuId             String
  menu               Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  // Kitchen-language name. The customer-facing menu stays in English; the
  // kitchen ticket prints this instead when it is set. A Chinese takeaway
  // runs an English menu for customers and a Chinese one for the wok, and
  // was otherwise keeping the two in the chef's head.
  //
  // Null (the default) means "no translation" — the ticket falls back to
  // `name`, so nothing changes for a shop that never fills this in.
  secondLanguageName String?
  imageUrl           String?
  sortOrder          Int      @default(0)
  isVisible          Boolean  @default(true)
  // Phase AK: many-to-many across menus. menuIds[] mirrors Base44's
  // pattern of letting a single category appear in multiple menus
  // without duplicating it. menuId above stays as the "primary" menu
  // (matches the existing service layer); menuIds is the authoritative
  // membership list used by Menu Manager filters and POS lookups.
  menuIds            String[] @default([])
  // available = staff toggle (hide everywhere). visibleToCustomers =
  // visibility on the customer storefront only; POS still sees it.
  available          Boolean  @default(true)
  visibleToCustomers Boolean  @default(true)

  // Import / sync (same pattern as Menu).
  platformSource   String?
  externalId       String?
  externalParentId String?
  lastSyncedAt     DateTime?
  syncStatus       String?
  syncHash         String?

  items         MenuItemOnCategory[]
  stationRoutes MenuCategoryStation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
  @@index([platformSource, externalId])
  @@map("menu_categories")
}

model MenuItem {
  id                 String    @id @default(cuid())
  brandId            String
  // Phase AP — Products section is location-scoped. When set, this
  // product only appears in the Products tab for that location.
  // Backfilled from "Pizza Uno Pelton" by the AP migration; rows that
  // didn't match keep this null until the operator reassigns them.
  locationId         String?
  name               String
  description        String?
  // Kitchen-language name. The customer-facing menu stays in English; the
  // kitchen ticket prints this instead when it is set. A Chinese takeaway
  // runs an English menu for customers and a Chinese one for the wok, and
  // was otherwise keeping the two in the chef's head.
  //
  // Null (the default) means "no translation" — the ticket falls back to
  // `name`, so nothing changes for a shop that never fills this in.
  secondLanguageName String?
  basePrice          Decimal   @db.Decimal(10, 2)
  imageUrl           String?
  // Pre-Phase-AK had `sku` as a generic product code. Base44 calls this
  // the PLU and uses it across all integration imports (Deliveroo
  // pos_item_id, HubRise ref, Uber external_data). We keep `sku` for
  // backward compatibility but `plu` is the authoritative field going
  // forward. Both default to null; PLU service backfills via the
  // "Generate missing PLUs" action in Menu Manager.
  sku                String?
  plu                String?
  isAvailable        Boolean   @default(true)
  // Hide from customer storefront only. POS still sees it. Separate
  // from isAvailable (which hides everywhere) and outOfStock (which
  // shows POS staff a "tap to restore" overlay).
  visibleToCustomers Boolean   @default(true)
  outOfStock         Boolean   @default(false)
  // Which SERVICE MODES this item is sold in. All three default true, so
  // every existing item behaves exactly as before.
  //
  // Distinct from the flags above, which are all about *temporary* state:
  // isAvailable hides it everywhere, outOfStock is an 86 the kitchen
  // restores, visibleToCustomers hides it from customers but not the till.
  // These three are a permanent property of the product — a 20" sharing
  // pizza that does not survive a moped, a table-service-only sharing
  // platter — so they are settings on the item, not stock state.
  //
  // Walk-in counter trade is recorded as PICKUP (see the KDS bucketing),
  // so it rides on availableCollection; availableDineIn is table tabs only.
  availableCollection Boolean  @default(true)
  availableDelivery   Boolean  @default(true)
  availableDineIn     Boolean  @default(true)
  // When set, the autoProgressOrders cron flips outOfStock back to false
  // at this time. Used for "out for an hour" scheduling.
  availableRestoreAt DateTime?
  allergens          String[]
  dietaryTags        String[]
  // Base44 had a separate `dietary` JSON field with platform-specific
  // dietary metadata (e.g. is_vegetarian, is_vegan as separate keys).
  // dietaryTags above stays for storefront filtering; this JSON carries
  // anything platform-flavoured we don't want to flatten.
  dietary            Json      @default("[]")
  calories           Int?
  prepTime           Int?
  metadata           Json      @default("{}")

  // ── Multi-SKU pricing ──────────────────────────────────────────────────
  // Base44's signature feature: a single product with multiple sizes,
  // each carrying its own price, PLU, AND its own modifier group list.
  // We store the whole SKU array as JSON to match Base44 1:1 (the
  // existing MenuItemVariant table stays for compatibility but is no
  // longer the source of truth for new code).
  //
  // Shape (when hasMultipleSkus = true):
  //   productSkus: [
  //     { name: "10 inch", plu: "PIZZA-10", price: 9.99,
  //       modifierGroups: ["grp_crusts", "grp_toppings_10"] },
  //     { name: "12 inch", plu: "PIZZA-12", price: 12.99,
  //       modifierGroups: ["grp_crusts", "grp_toppings_12"] }
  //   ]
  //
  // Size key extracted from name via /(\d+)\s*(?:inch|"|in)?/i — see
  // packages/shared/src/lib/menu-pricing.ts.
  hasMultipleSkus Boolean @default(false)
  productSkus     Json    @default("[]")

  // Per-channel tax. Stored as percentage points (20.00 = 20%).
  deliveryTax Decimal @default(0) @db.Decimal(5, 2)
  takeawayTax Decimal @default(0) @db.Decimal(5, 2)
  eatInTax    Decimal @default(0) @db.Decimal(5, 2)

  // Membership in many menus. Base44 stores menu IDs as a plain array
  // because a single product can appear in the Lunch menu AND the
  // Dinner menu AND a Deliveroo-only menu.
  menuIds   String[] @default([])
  // Same idea for brands — supports dark-kitchen scenarios where one
  // product is sold under multiple virtual brands.
  brandIds  String[] @default([])
  // sortOrder is preserved at the Category↔Item link level
  // (MenuItemOnCategory.sortOrder). This top-level sortOrder is the
  // default ordering when the item isn't in a category.
  sortOrder Int      @default(0)

  // Inventory tracking
  isInventoryTracked Boolean @default(false)
  inventoryCount     Int?

  // Platform-specific pricing overrides
  platformPricingOverrides Json @default("{}")

  // ── Import / sync ──────────────────────────────────────────────────────
  platformSource      String?
  externalId          String?
  externalParentId    String?
  lastSyncedAt        DateTime?
  syncStatus          String?
  syncHash            String?
  // Raw modifier-group IDs from the source platform. Kept as JSON so the
  // importer can re-link after creating local ModifierGroup rows.
  rawModifierGroupIds Json      @default("[]")

  categories          MenuItemOnCategory[]
  modifierGroupLinks  ModifierGroupOnItem[]
  variants            MenuItemVariant[]
  recipe              Recipe?
  stationRoutes       MenuItemStation[]
  // Phase AW-14 — per-channel snooze records ("86" board). One row
  // per (item, channel) currently snoozed; absence = available.
  channelAvailability MenuItemChannelAvailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, isAvailable])
  @@index([plu])
  @@index([platformSource, externalId])
  @@map("menu_items")
}

// Phase AW-15 — Stop-taking-orders ("storefront pause").
//
// Per-(location, brand, channel) pause records. Granularity is set by
// which columns are non-null:
//
//   locationId only            → pause the whole location (all brands,
//                                 all channels)
//   locationId + brandId        → pause just this brand at this
//                                 location (all its channels)
//   locationId + channel        → pause this channel at this location
//                                 (all brands)
//   locationId + brandId + ch.  → pause exactly this brand's channel
//
// A given (loc, brand, channel) is "paused now" if ANY row with
//   resumeAt = NULL OR resumeAt > now()
// matches one of those four hierarchies. The storefront / POS /
// HubRise call sites use isPaused() in PauseService for the OR-walk.
//
// `mode` distinguishes a hard pause from busy mode (still accepting
// orders, just with extra prep time bolted on). extra_preparation_time
// is only set in BUSY rows.
model ChannelPause {
  id            String    @id @default(cuid())
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  brandId       String?
  channel       String?
  mode          String    @default("paused") // "paused" | "busy"
  resumeAt      DateTime?
  reason        String?
  extraPrepTime Int?
  pausedAt      DateTime  @default(now())
  pausedBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Operators may pause "all of brand X" and then layer "channel Y at
  // brand X" on top with a different reason — both rows coexist and
  // either triggers the closed banner. No uniqueness constraint.
  @@index([locationId])
  @@index([brandId])
  @@index([channel])
  @@index([locationId, resumeAt])
  @@map("channel_pauses")
}

// Phase AW-14 — Menu Availability ("86 board").
//
// Operators flip a single product off for one channel at a time
// (e.g. "out of stock on Online ordering for 2 hours"). One row
// per (itemId, channel) pair; presence with isAvailable=false and
// expiresAt > now() means the storefront / POS / marketplace hides
// the item. Cleared by either: expiresAt elapsing (read-time check,
// no cron needed) or an explicit unsnooze row delete.
//
// `channel` is a free-form string matching the publishedTo[] enum:
// ONLINE, POS, JUST_EAT, UBER_EATS, DELIVEROO, WHATSAPP, HUBRISE.
// Per-channel intentionally — operators want to 86 a pizza on Uber
// Eats only without taking it off the in-store POS.
model MenuItemChannelAvailability {
  id           String    @id @default(cuid())
  itemId       String
  item         MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  channel      String
  // Phase BA — per-location snoozes. NULL = "all locations" (every
  // pre-BA row, plus deliberate global 86s). A non-null locationId
  // scopes the snooze to that location only, so 86ing at location A
  // never affects location B. Uniqueness for the NULL slice is kept by
  // a raw partial unique index in the BA migration (Postgres treats
  // NULLs as distinct in the compound unique below).
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  // Always false in current rows — the row's existence IS the snooze.
  // Kept on the model so a future "explicit in-stock with count"
  // record can ride the same table without an enum change.
  isAvailable  Boolean   @default(false)
  // ISO timestamp. Read-time filter compares against now(); past
  // values are treated as expired (auto-unsnooze).
  expiresAt    DateTime?
  // Operator-supplied reason, free text. Surfaced on the inventory
  // board so the next shift knows why a product is out.
  snoozeReason String?
  // For audit + the inventory board's "snoozed N minutes ago" label.
  snoozedAt    DateTime  @default(now())
  snoozedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, channel, locationId])
  @@index([itemId])
  @@index([channel, expiresAt])
  @@index([locationId])
  @@map("menu_item_channel_availability")
}

model MenuItemOnCategory {
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemId        String
  item          MenuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sortOrder     Int          @default(0)
  priceOverride Decimal?     @db.Decimal(10, 2)
  isVisible     Boolean      @default(true)

  @@id([categoryId, itemId])
  @@map("menu_items_on_categories")
}

// ── Modifier Groups ───────────────────────────────────────────────────────────
model ModifierGroup {
  id                       String        @id @default(cuid())
  brandId                  String
  brand                    Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  // Phase AP — Products section is location-scoped. Same backfill rule
  // as MenuItem.locationId.
  locationId               String?
  name                     String
  description              String?

  // Kitchen-language name — see MenuItem.secondLanguageName. Null means the
  // ticket prints the English one.
  secondLanguageName       String?
  plu                      String?
  minSelections            Int           @default(0)
  maxSelections            Int?
  isRequired               Boolean       @default(false)
  sortOrder                Int           @default(0)
  // VARIANT = pick-one (radio); ADDON = pick-many (checkbox).
  // Mapped from Uber's quantity_info.max_permitted (1 = variant, >1 = addon)
  // and from Deliveroo's min/max_selection fields.
  selectionType            SelectionType @default(VARIANT)
  // ADDON groups only — does the same modifier option count twice when
  // ticked twice (e.g. "extra cheese x2" = +£1.00 instead of +£0.50).
  allowDuplicateSelections Boolean       @default(false)
  visibleToCustomers       Boolean       @default(true)

  // Many-to-many membership in menus, mirroring Base44.
  menuIds String[] @default([])

  // ── Import / sync ──────────────────────────────────────────────────────
  platformSource   String?
  externalId       String?
  externalParentId String?
  lastSyncedAt     DateTime?
  syncStatus       String?
  syncHash         String?
  // Raw modifier (option) IDs from the source platform — re-linked after
  // ModifierOption rows are created.
  rawModifierIds   Json      @default("[]")

  options            ModifierOption[]
  itemLinks          ModifierGroupOnItem[]
  nestedUnderOptions ModifierOption[]       @relation("NestedModifier")
  // Phase BN — the groups this group hangs off, when it is a nested
  // (second-level) group opened by choosing a particular option.
  parentOptionLinks  ModifierOptionNestedGroup[]
  stationRoutes      ModifierGroupStation[]

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([plu])
  @@index([platformSource, externalId])
  @@map("modifier_groups")
}

model ModifierOption {
  id                       String        @id @default(cuid())
  groupId                  String
  group                    ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Phase AK — Base44 lets the same modifier (e.g. "Extra cheese")
  // belong to multiple groups. We keep groupId above as the "primary"
  // group (so existing service code keeps working) and add a parallel
  // array of additional group memberships. Imports populate both;
  // POS lookups can match either.
  modifierGroupIds         String[]      @default([])
  name                     String
  description              String?
  // Kitchen-language name. The customer-facing menu stays in English; the
  // kitchen ticket prints this instead when it is set. A Chinese takeaway
  // runs an English menu for customers and a Chinese one for the wok, and
  // was otherwise keeping the two in the chef's head.
  //
  // Null (the default) means "no translation" — the ticket falls back to
  // `name`, so nothing changes for a shop that never fills this in.
  secondLanguageName String?
  // Base price for this modifier when no size key matches. Already
  // existed; renamed conceptually to "default price". pricesBySize
  // below is the authoritative per-size table.
  priceAdjustment          Decimal       @default(0) @db.Decimal(10, 2)
  // PLU — same role as MenuItem.plu. Used by Deliveroo PLU validation.
  plu                      String?
  // ── Per-size pricing + PLU ─────────────────────────────────────────
  // Used when the parent product is a multi-SKU pizza-style item. Keys
  // are size strings (e.g. "10", "12", "14") extracted from the size
  // modifier's name. Values are the per-size price / PLU.
  //   pricesBySize: { "10": 0.50, "12": 0.75, "14": 1.00 }
  //   skuPlus:      { "10": "TOP-CHEESE-10", "12": "TOP-CHEESE-12" }
  //
  // Visibility rule (enforced in the POS modifier modal):
  //   - if pricesBySize has keys AND the selected size key is NOT a
  //     key here, the option is HIDDEN (not just disabled).
  //   - if pricesBySize is empty, the option is always visible at
  //     priceAdjustment.
  pricesBySize             Json          @default("{}")
  skuPlus                  Json          @default("{}")
  // Per-variant price overrides keyed by pricing-variant ref, e.g.
  // { "UBER_EATS": 0.75, "var_kiosk": 0.50 }. Empty = this option costs
  // priceAdjustment on every variant. Published as option price_overrides.
  platformPricingOverrides Json          @default("{}")
  imageUrl                 String?
  allergens                String[]
  isDefault                Boolean       @default(false)
  isAvailable              Boolean       @default(true)
  visibleToCustomers       Boolean       @default(true)
  // Scheduled restore — same pattern as MenuItem.availableRestoreAt.
  availableRestoreAt       DateTime?
  sortOrder                Int           @default(0)
  // Membership in many menus. Same rationale as MenuCategory.menuIds.
  menuIds                  String[]      @default([])

  // Per-channel tax — % points, matches MenuItem.
  deliveryTax Decimal @default(0) @db.Decimal(5, 2)
  takeawayTax Decimal @default(0) @db.Decimal(5, 2)
  eatInTax    Decimal @default(0) @db.Decimal(5, 2)

  // ── Import / sync ──────────────────────────────────────────────────
  platformSource   String?
  externalId       String?
  externalParentId String?
  lastSyncedAt     DateTime?
  syncStatus       String?
  syncHash         String?

  // Phase E added this single-FK nesting link but nothing ever read it.
  // It can only hold ONE group, and the real shape needs more than one —
  // "Make It a Meal" opens a sides picker AND a drinks picker. Superseded
  // by nestedGroupLinks below. Left in place rather than dropped: this is
  // a live catalog, and removing a column buys nothing.
  nestedGroupId String?
  nestedGroup   ModifierGroup? @relation("NestedModifier", fields: [nestedGroupId], references: [id], onDelete: SetNull)

  // Phase BN — modifier groups that open when THIS option is chosen.
  // Recursion falls out of the model: a nested group's own options can
  // carry their own nested groups (Make It a Meal → Fries → Garlic Mayo).
  // Readers must cap depth and guard against cycles — nothing in the
  // schema prevents a group from nesting under its own descendant.
  nestedGroupLinks ModifierOptionNestedGroup[]

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([plu])
  @@index([platformSource, externalId])
  @@map("modifier_options")
}

// ── Phase BN — nested modifier groups ─────────────────────────────────────────
// Deliveroo (and Uber, and any menu with a meal deal) nests modifier groups
// under an option rather than under a product:
//
//   Big Boss Burger
//   └── Make It a Meal (group)
//       └── Make It a Meal +£3.99 (option)
//           ├── Choose Side (group)   ← a row here
//           │   └── Fries (option)
//           │       └── Dip (group)   ← and here, one level deeper
//           └── Choose Drink (group)  ← and here
//
// Deliberately a join table rather than an array of ids on the option:
// sortOrder decides that "Choose Side" is asked before "Choose Drink", and
// the FK means deleting a group can't leave an option pointing at nothing.
// Same shape as ModifierGroupOnItem, which does the same job one level up.
model ModifierOptionNestedGroup {
  optionId  String
  option    ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  groupId   String
  group     ModifierGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)

  createdAt DateTime @default(now())

  @@id([optionId, groupId])
  @@index([optionId])
  @@index([groupId])
  @@map("modifier_option_nested_groups")
}

model ModifierGroupOnItem {
  itemId    String
  item      MenuItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder Int           @default(0)

  @@id([itemId, groupId])
  @@index([itemId])
  @@map("modifier_groups_on_items")
}

model MenuItemVariant {
  id          String   @id @default(cuid())
  itemId      String
  item        MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  price       Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@map("menu_item_variants")
}

// ── Phase AL — Meal Deals (master catalog) ────────────────────────────────────
// A meal deal is a curated bundle (e.g. "Burger + Fries + Drink for £8.99").
// Sections describe each pick step ("Choose 1 burger", "Choose 1 side").
// Stored as JSON to match the variable structure platforms expect and to
// keep iteration cheap while we figure out the editor UX.
model MealDeal {
  id                       String   @id @default(cuid())
  brandId                  String
  brand                    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  // Locations this meal deal is available at. Empty array = all locations
  // of the brand. Stored as a Postgres text array — matches Base44's
  // membership pattern.
  locationIds              String[] @default([])
  name                     String
  description              String?
  imageUrl                 String?
  // PLU/ref used by integrations.
  plu                      String?
  // Total bundle price. When null, the deal is computed from
  // sum(selected product prices) at order time.
  price                    Decimal? @db.Decimal(10, 2)
  // sections[] = each pick step in the deal. Shape:
  //   [{
  //     name: "Choose your burger",
  //     minChoices: 1, maxChoices: 1,
  //     options: [{ menuItemId, priceOverride?, defaultModifierGroupIds[] }]
  //   }, ...]
  sections                 Json     @default("[]")
  // Per-channel tax — same format as MenuItem (percentage points).
  deliveryTax              Decimal  @default(0) @db.Decimal(5, 2)
  takeawayTax              Decimal  @default(0) @db.Decimal(5, 2)
  eatInTax                 Decimal  @default(0) @db.Decimal(5, 2)
  // Platform price overrides — { POS: 8.99, UBER_EATS: 9.49, ... }
  platformPricingOverrides Json     @default("{}")
  isAvailable              Boolean  @default(true)
  visibleToCustomers       Boolean  @default(true)
  sortOrder                Int      @default(0)

  // Import / sync — same pattern as MenuItem.
  platformSource String?
  externalId     String?
  lastSyncedAt   DateTime?
  syncStatus     String?
  syncHash       String?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, isAvailable])
  @@index([plu])
  @@map("meal_deals")
}

// ── Phase AL — Upsell Groups (master catalog) ────────────────────────────────
// "Customers who added X also liked Y" — surfaced on the cart screen or in
// the customer storefront. Trigger products are what makes the upsell fire;
// suggested products are what gets shown.
model UpsellGroup {
  id                  String   @id @default(cuid())
  brandId             String
  brand               Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  // When ANY of these products / categories are in the cart, the upsell
  // surfaces the `suggestedProductIds`. IDs are MenuItem.id or
  // MenuCategory.id depending on which array they appear in.
  triggerProductIds   String[] @default([])
  triggerCategoryIds  String[] @default([])
  // What to show. Storefront shows them as a "you might also like" row.
  suggestedProductIds String[] @default([])
  // Sort order between competing upsells (e.g. show dessert before drinks).
  sortOrder           Int      @default(0)
  // Platforms that should surface this upsell. Empty = all platforms.
  // Values are OrderSource enum strings: ONLINE, POS, UBER_EATS, ...
  platformVisibility  String[] @default([])
  isActive            Boolean  @default(true)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, isActive])
  @@map("upsell_groups")
}

model MenuVersion {
  id        String  @id @default(cuid())
  menuId    String
  menu      Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  label     String?
  createdBy String?

  createdAt DateTime @default(now())

  @@unique([menuId, version])
  @@index([menuId])
  @@map("menu_versions")
}

// ── Customer CRM ──────────────────────────────────────────────────────────────
model Customer {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email            String?
  phone            String?
  firstName        String?
  lastName         String?
  marketingConsent Boolean  @default(false)
  isActive         Boolean  @default(true)
  tags             String[]
  metadata         Json     @default("{}")

  // Phase AP — link to a Supabase Auth user when the customer signs in
  // on the storefront. Nullable so existing rows (created from delivery
  // platforms / staff entry) keep working.
  supabaseUserId String?   @unique
  lastSignInAt   DateTime?

  addresses      CustomerAddress[]
  orders         Order[]
  loyalty        LoyaltyAccount?
  paymentMethods PaymentMethod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, email])
  @@map("customers")
}

// Phase AP — Direct online ordering per-location settings.
// Drives what the storefront displays + what it accepts. Operators
// edit this from a new "Direct online ordering" tab in the POS top bar.
model DirectOrderingConfig {
  id         String    @id @default(cuid())
  tenantId   String
  // Phase AW — keyed by brand. locationId stays for legacy reads + the
  // backfill window; AW-2 API writes only touch brandId. Both are
  // nullable-unique so a row in flight has exactly one of them set.
  locationId String?   @unique
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  brandId    String?   @unique
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  deliveryPrepMinutes   Int @default(45)
  collectionPrepMinutes Int @default(20)

  acceptsCash       Boolean @default(true)
  acceptsCard       Boolean @default(true)
  acceptsDelivery   Boolean @default(true)
  acceptsCollection Boolean @default(true)

  scheduleMaxDaysAhead Int      @default(7)
  scheduleSlotMinutes  Int      @default(15)
  minOrderForDelivery  Decimal? @db.Decimal(10, 2)
  heroImageUrl         String?

  // When false, the public storefront hides all item photos and shows a
  // clean text-only menu (some operators prefer this, or lack good photos).
  showItemImages Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("direct_ordering_configs")
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?
  line1       String
  line2       String?
  city        String
  postcode    String
  country     String   @default("GB")
  isDefault   Boolean  @default(false)
  coordinates Json?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_addresses")
}

model LoyaltyAccount {
  id          String   @id @default(cuid())
  customerId  String   @unique
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenantId    String
  points      Int      @default(0)
  tier        String   @default("BRONZE")
  totalSpend  Decimal  @default(0) @db.Decimal(10, 2)
  totalOrders Int      @default(0)
  metadata    Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("loyalty_accounts")
}

// ── Promo Codes ───────────────────────────────────────────────────────────────
model PromoCode {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  description   String?
  type          PromoCodeType
  value         Decimal       @db.Decimal(10, 2)
  minOrderValue Decimal?      @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int           @default(0)
  startAt       DateTime?
  expiresAt     DateTime?
  isActive      Boolean       @default(true)
  locationIds   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("promo_codes")
}

// ── MarketingCampaign (Phase AW-19) ─────────────────────────────────────────
//
// Generic campaign row covering all the offer types in the Marketing UI
// picker (Percentage off, BOGO, % off items, Amount off, Free item, Free
// delivery, Happy hour). One brand-channel campaign per row. Type-specific
// fields are nullable — the form only fills the ones its type needs.
//
// Audience: enum bucket the storefront + POS evaluate against the
// customer's order history at apply time. The buckets are computed from
// CustomerAccount.totalOrders + Order timestamps (see the campaign
// service's resolveAudience helper).
model MarketingCampaign {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?

  // The offer type. Drives which type-specific columns are read.
  // PERCENTAGE_OFF      → percentageOff + minOrder (+ optional dailyStart/End for Happy hour)
  // AMOUNT_OFF_ORDER    → amountOff + minOrder
  // PERCENT_OFF_ITEMS   → percentageOff + itemIds[]
  // BOGO                → buyOneGetOne (free / 50% off, configured in metadata)
  // FREE_ITEM           → freeItemId + minOrder
  // FREE_DELIVERY       → minOrder
  // HAPPY_HOUR          → percentageOff + dailyStartTime + dailyEndTime
  type CampaignType

  // ACTIVE rows are evaluated at order time. DRAFT is the operator's
  // half-built campaign. PAUSED is operator-stopped without deleting.
  // ENDED is set by a daily cron once endsAt elapses.
  status CampaignStatus @default(DRAFT)

  // Which customer cohort can see / use this campaign. Storefront +
  // POS compute the bucket per-customer; ALL bypasses the check.
  audience CampaignAudience @default(ALL)

  // Free-form set matching publishedTo + the channels used elsewhere
  // (ONLINE / POS / JUST_EAT / UBER_EATS / DELIVEROO / WHATSAPP /
  // HUBRISE). Empty array = no channel selected (campaign is dormant).
  channels String[] @default([])

  // Type-specific fields. All nullable so a row only fills what its
  // type needs.
  percentageOff  Decimal? @db.Decimal(5, 2)
  amountOff      Decimal? @db.Decimal(10, 2)
  minOrder       Decimal? @db.Decimal(10, 2)
  freeItemId     String?
  itemIds        String[] @default([])
  // HH:MM 24h. Local to the brand's timezone (brand inherits from
  // location's tz at evaluation time).
  dailyStartTime String?
  dailyEndTime   String?

  // Window. null = open-ended. The daily cron flips status to ENDED
  // when endsAt < now.
  startsAt DateTime?
  endsAt   DateTime?

  // Caps. null = no cap.
  maxRedemptions   Int?
  perCustomerLimit Int?
  redemptionCount  Int  @default(0)

  // Anything UI-only or type-specific that doesn't justify a column.
  // For BOGO: { mode: "free" | "half_price", trigger_item_id, reward_item_id }.
  metadata Json @default("{}")

  // Per-order attribution — one row each time the campaign actually
  // applied to an order (drives the Marketing page's performance
  // insights: Sales, Orders, New customers).
  redemptions CampaignRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([tenantId])
  @@index([brandId])
  @@index([tenantId, status])
  @@index([brandId, status])
  @@map("marketing_campaigns")
}

// Phase MK-INSIGHTS — records each time a MarketingCampaign discount was
// applied to an order, so the Marketing page can show real per-campaign
// performance (Sales/Orders/New customers) over a date range, like the
// Uber Eats Manager "Offers" view. Written best-effort at checkout; a
// missing row never fails an order. Attribution is forward-only — orders
// placed before this shipped have no rows.
model CampaignRedemption {
  id         String            @id @default(cuid())
  tenantId   String
  campaignId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brandId    String
  orderId    String
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Channel the order came through (ONLINE, POS, …) — lets insights be
  // sliced per channel later.
  channel String @default("ONLINE")

  // Who redeemed — null for guest checkouts. isNewCustomer is the
  // audience bucket resolved at order time (first-ever order → true),
  // so "New customers" can be counted without re-deriving history.
  customerAccountId String?
  isNewCustomer     Boolean @default(false)

  // Money captured at redemption time. discountAmount = £ taken off by
  // THIS campaign; orderTotal = the order's gross total (= "Sales").
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  orderTotal     Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([orderId, campaignId])
  @@index([campaignId, createdAt])
  @@index([tenantId])
  @@index([brandId])
  @@map("campaign_redemptions")
}

enum CampaignType {
  PERCENTAGE_OFF
  AMOUNT_OFF_ORDER
  PERCENT_OFF_ITEMS
  BOGO
  FREE_ITEM
  FREE_DELIVERY
  HAPPY_HOUR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum CampaignAudience {
  ALL
  NEW
  RETURNING
  LAPSED
}

// ── DeliveryZone (Phase AM) ──────────────────────────────────────────────────
// One row per (location, postcodePrefix) so the POS can look up a fee by the
// first letters of a postcode. Free delivery is modelled as fee=0.
// minOrderValue is enforced at order-creation time when set.
model DeliveryZone {
  id             String    @id @default(cuid())
  tenantId       String
  // Phase AW-30 — keyed by brand OR location. Storefront prefers
  // brand zones when the URL pins a brand; falls back to location
  // zones for legacy single-brand kitchens. Exactly one of brandId
  // or locationId is set per row.
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  brandId        String?
  brand          Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  /// Postcode mode: the prefix a customer's postcode must start with.
  /// Null on radius and area rows.
  postcodePrefix String?
  /// Area mode: the named community this row prices, e.g. "Dubai Marina".
  /// Null on postcode and radius rows.
  ///
  /// The Gulf has no usable postcodes — a Dubai address is building, community,
  /// emirate — so the operator lists the areas they serve and the customer
  /// picks one. These rows ARE the customer's picker, which is why matching is
  /// exact rather than fuzzy: an area that isn't listed means the shop does not
  /// deliver there, not that someone mistyped.
  areaName       String?
  /// Radius mode: the outer edge of this band, in miles. A row with 3.0 means
  /// "up to 3 miles". Null on postcode rows.
  ///
  /// A zone set uses ONE mode — the presence of any radius row is what puts a
  /// brand in radius mode, so there is no separate flag to drift out of step
  /// with the rows it describes.
  maxDistanceMiles Decimal? @db.Decimal(6, 2)
  fee            Decimal   @db.Decimal(10, 2)
  minOrderValue  Decimal?  @db.Decimal(10, 2)
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, postcodePrefix])
  @@unique([brandId, postcodePrefix])
  @@unique([locationId, areaName])
  @@unique([brandId, areaName])
  @@index([tenantId])
  @@index([locationId])
  @@index([brandId])
  @@map("delivery_zones")
}

// ── LocationPaymentConfig (Phase AM) ─────────────────────────────────────────
// One row per location holding the merchant's payment provider preference.
// Secrets/credentials stay in the existing `integrations` row — this only
// tracks selection + which methods (cash/card terminal/online) are enabled.
model LocationPaymentConfig {
  id                   String   @id @default(cuid())
  tenantId             String
  locationId           String   @unique
  location             Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  provider             String   @default("MANUAL") // MANUAL | STRIPE | DOJO | ADYEN | WORLDPAY
  cashEnabled          Boolean  @default(true)
  cardTerminalEnabled  Boolean  @default(true)
  onlinePaymentEnabled Boolean  @default(false)
  config               Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("location_payment_configs")
}

// ── Order ─────────────────────────────────────────────────────────────────────
model Order {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locationId        String
  location          Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customerId        String?
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Phase AP-5 — link to the authenticated CustomerAccount (the
  // identity that signed in via Google / email-password). Distinct
  // from `customerId` which is the per-tenant CRM record. Used to
  // power the customer "My Orders" page.
  customerAccountId String?
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  // Optional brand reference. A single location can serve multiple virtual
  // brands (e.g. "Greek Gyros" and "crunchy chikin" run from the same kitchen).
  // Used to badge orders on the board and scope per-brand reporting.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  externalId  String?
  platform    OrderPlatform
  displayId   String?
  // Phase AM — sequential per-tenant POS/DIRECT order number ("#1").
  // External-platform orders keep their own displayId (Just Eat order
  // ref, Uber Eats display_id, etc.) and leave this null.
  orderNumber Int?

  orderSource       OrderSource       @default(DIRECT)
  integrationSource IntegrationSource @default(DIRECT)
  viaHubrise        Boolean           @default(false)

  // Phase AV — who actually drives the delivery on this order.
  //   MERCHANT  — restaurant's own driver. Operator walks the order
  //               all the way through OUT_FOR_DELIVERY → DELIVERED on
  //               our dashboard.
  //   PLATFORM  — marketplace courier (Uber Eats / Deliveroo / Just
  //               Eat). Operator can only mark ACCEPTED → PREPARING →
  //               READY; the post-READY transitions are driven by
  //               HubRise's delivery.update webhooks. null for orders
  //               where the model isn't applicable (POS pickup, etc.).
  deliveryType String? // MERCHANT | PLATFORM | null

  // Courier tracking — populated from HubRise delivery.* webhooks for
  // PLATFORM orders. Stored as flat columns so the dashboard can render
  // them without parsing metadata JSON.
  courierName            String?
  courierPhone           String?
  // Phase AV-3 — anonymised-call PIN HubRise routes through the
  // marketplace's masking number. Without it the operator can dial
  // courierPhone but the call won't connect (the carrier looks up
  // which active delivery uses that PIN). Same shape exists customer-
  // side (customerInfo.phoneAccessCode in the JSON blob).
  courierPhoneAccessCode String?
  courierTrackingUrl     String?
  courierStatus          String? // HubRise delivery status enum verbatim
  courierAssignedAt      DateTime?
  courierPickedUpAt      DateTime?
  courierDeliveredAt     DateTime?
  // The courier network's own estimated arrival time, when it gives one
  // (Deliveroo sends `estimated_arrival_time` on every rider event).
  // Deliveroo NEVER reports a delivery to the merchant — not on the rider
  // webhook, not on the order webhook, not in the order audit trail — so
  // this estimate is the only basis for closing a platform-courier order
  // before the 05:00 rollover. See DeliverooOrderPollService.
  courierEtaAt           DateTime?
  // Which courier network fulfils this order + its job id there. Set when an
  // operator dispatches to a fleet provider (STUART). courierJobId is the
  // provider's delivery/job id — the webhook resolves the order by it.
  courierProvider        String? // STUART (later: UBER_DIRECT, …)
  courierJobId           String?

  status          OrderStatus     @default(PENDING)
  fulfillmentType FulfillmentType @default(DELIVERY)
  // Table Tabs — set on a DINE_IN order that is a table's running tab.
  tableId         String?
  // Guests on the tab, copied off the table at settle so dine-in
  // reporting can do spend-per-head after the table is freed.
  covers          Int?
  // Counter trade: a POS walk-in or a self-service kiosk order. Tagged
  // explicitly rather than inferred from customerName == "Walk-in", which
  // breaks the first time a customer is actually called that.
  isWalkIn        Boolean         @default(false)

  customerInfo  Json
  customerName  String?
  customerPhone String?

  deliveryAddress Json?

  // Phase AX — Dispatch. Geocoded delivery coordinates cached on the order
  // so the dispatch map can drop a pin without re-geocoding every render.
  // Populated on ingest from deliveryAddress via the Google geocoder.
  deliveryLat Float?
  deliveryLng Float?
  geocodedAt  DateTime?

  subtotal      Decimal @db.Decimal(10, 2)
  taxAmount     Decimal @default(0) @db.Decimal(10, 2)
  // Auto-applied service charge (dine-in). Kept out of subtotal so receipts
  // itemise it, refunds can reason about it, and dine-in reporting totals it
  // apart from food revenue.
  serviceCharge Decimal @default(0) @db.Decimal(10, 2)
  // Customer gratuity, kept by the RESTAURANT (not a courier). Sits beside
  // the other money columns so the order card, the ticket and reporting can
  // all show what was tipped rather than only a total that silently includes
  // it.
  tipAmount     Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee   Decimal @default(0) @db.Decimal(10, 2)
  discount      Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  isSandbox Boolean @default(false)

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?

  promoCode     String?
  promoDiscount Decimal? @db.Decimal(10, 2)

  specialInstructions String?
  scheduledFor        DateTime?
  scheduledAt         DateTime? // Phase AM — POS-side mirror of scheduledFor for the operator UI
  estimatedReadyAt    DateTime?
  idempotencyKey      String?   @unique

  // Phase AJ — Base44 parity fields surfaced in UI / printer payload.
  // Other Base44 fields (courier_*, food_photo_url, stripe_*, hubrise_*, etc.)
  // continue to live in `metadata` JSONB until they need to be queryable.
  collectionCode     String? // shown on customer receipt + driver handoff
  preparationMinutes Int? // overrides default prep time for this order
  failureReason      String? // populated when status transitions to FAILED

  // Phase AM — POS operational fields. addressLine1/2/city/postcode are the
  // structured mirror of deliveryAddress JSON (we keep both for backwards-
  // compat with webhook adapters that still consume the JSON shape).
  // callerId is set when an incoming-call lookup pre-fills the cart.
  // discountType records WHICH quick-button was applied (PERCENT_10 /
  // PERCENT_20 / FREE_DELIVERY / PROMO_CODE) — the actual amount lives in
  // `discount`. paymentProvider records which provider handled the charge
  // (e.g. STRIPE / DOJO / ADYEN / CASH) when one was wired up.
  addressLine1    String?
  addressLine2    String?
  city            String?
  postcode        String?
  callerId        String?
  discountType    String?
  paymentProvider String?

  receivedAt       DateTime  @default(now())
  acceptedAt       DateTime?
  preparingAt      DateTime?
  readyAt          DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  metadata       Json @default("{}")
  sourceMetadata Json @default("{}")

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  kdsTickets       KdsTicket[]
  printJobs        PrintJob[]
  driverAssignment DriverAssignment?
  payments         Payment[]

  // Phase MK-INSIGHTS — marketing campaigns that applied to this order.
  campaignRedemptions CampaignRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalId, platform])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, locationId])
  @@index([tenantId, orderSource])
  @@index([locationId, createdAt(sort: Desc)])
  @@index([locationId, status])
  @@index([locationId, orderSource])
  @@index([platform])
  @@index([orderSource])
  @@index([integrationSource])
  @@index([tenantId, customerPhone])
  @@index([tenantId, customerName])
  @@index([courierJobId])
  @@index([locationId, status, createdAt(sort: Asc)])
  @@index([scheduledFor])
  @@index([customerId])
  @@index([brandId])
  @@index([tenantId, brandId])
  @@index([brandId, status])
  @@index([tenantId, orderNumber])
  @@index([tableId])
  @@map("orders")
}

// Phase AM — per-tenant monotonic counter for POS/DIRECT order numbers.
// Incremented inside a SERIALIZABLE transaction so concurrent POS submits
// can't collide on the same #N.
model OrderNumberSequence {
  tenantId  String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("order_number_sequences")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  name       String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  modifiers  Json    @default("[]")
  notes      String?
  metadata   Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String               @id @default(cuid())
  orderId    String
  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId   String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  OrderStatusActorType @default(SYSTEM)
  changedBy  String?
  note       String?
  metadata   Json                 @default("{}")

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([orderId, toStatus])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("order_status_history")
}

// ── WebhookEvent ──────────────────────────────────────────────────────────────
model WebhookEvent {
  id              String    @id @default(cuid())
  platform        String
  externalEventId String
  tenantId        String?
  locationId      String?
  signature       String?
  rawPayload      Json
  processedAt     DateTime?
  processingError String?
  retryCount      Int       @default(0)
  orderId         String?
  metadata        Json      @default("{}")

  receivedAt DateTime @default(now())

  @@unique([platform, externalEventId])
  @@index([platform, receivedAt(sort: Desc)])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([orderId])
  @@map("webhook_events")
}

// ── ActivityLog ───────────────────────────────────────────────────────────────
// Phase LG — operator-facing activity feed (HubRise-style "what happened").
// One row per integration/system action: menu publishes, order pushes,
// stock changes, store pauses. Distinct from AuditLog (security/user audit)
// and WebhookEvent (raw inbound payloads) — this is the readable timeline
// the dashboard Logs page renders so operators don't need Render logs.
model ActivityLog {
  id         String  @id @default(cuid())
  tenantId   String
  locationId String?
  brandId    String?
  category   String // MENU | ORDERS | INVENTORY | STATUS | CONNECTION
  channel    String? // UBER_EATS | DELIVEROO | HUBRISE | JUST_EAT | DIRECT | SYSTEM
  action     String // e.g. menu.publish, order.accept, store.pause
  status     String // SUCCESS | ERROR | INFO | WARNING
  message    String
  details    Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, category, createdAt(sort: Desc)])
  @@index([tenantId, locationId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

// ── KDS ───────────────────────────────────────────────────────────────────────
model KdsScreen {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  station    String
  isActive   Boolean  @default(true)
  settings   Json     @default("{}")

  tickets KdsTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([locationId, isActive])
  @@map("kds_screens")
}

// Digital Signage — in-store menu boards on TV screens. Each row is one screen
// at a location showing a chosen, ordered subset of the location's POS menu
// categories. Prices/86-state are NOT stored here — the public render endpoint
// resolves them live from the POS menu (findActiveMenuForLocation) so the board
// always matches the till. `publicToken` is a random, unguessable id for the
// no-login TV URL (/signage/<token>); tenantId is denormalised because Location
// scopes to a tenant via brand, not a column (same pattern as KdsScreen).
model SignageDisplay {
  id          String   @id @default(cuid())
  tenantId    String
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name        String
  publicToken String   @unique
  categoryIds String[] @default([])
  orientation String   @default("landscape")
  config      Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@map("signage_displays")
}

// Table Tabs (dine-in) — a physical table at a location. `status` is FREE or
// OCCUPIED; `currentOrderId` points at the open tab order (one growing DINE_IN
// order per table) and is null when the table is free. tenantId is denormalised
// (Location scopes to a tenant via brand, same pattern as KdsScreen/Signage).
model Table {
  id             String    @id @default(cuid())
  tenantId       String
  locationId     String
  location       Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name           String
  seats          Int?
  area           String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  status         String    @default("FREE")
  currentOrderId String?
  openedAt       DateTime?

  // ── Floor plan (Phase 2) ────────────────────────────────────────────
  // Position on the room grid. Null = never placed; the floor page falls
  // back to the flat area/sortOrder list so existing tables keep working
  // until someone actually opens the layout editor.
  posX   Int?
  posY   Int?
  shape  String @default("SQUARE") // SQUARE | ROUND | RECT
  width  Int    @default(1) // in grid cells
  height Int    @default(1)

  // ── Availability (Phase 2) ──────────────────────────────────────────
  // bookableOnline: guests may reserve it from the storefront.
  // outOfService : staff pulled it entirely (broken, being cleaned, held
  //                back) — blocks BOTH walk-in seating and online
  //                booking, unlike bookableOnline which only shuts the
  //                internet out.
  bookableOnline   Boolean @default(true)
  outOfService     Boolean @default(false)
  outOfServiceNote String?

  // ── QR at table (Phase 3) ───────────────────────────────────────────
  // Opaque token printed on the table's QR sticker. Rotatable without
  // touching the table id, so a photographed code can be killed.
  qrToken   String? @unique
  qrEnabled Boolean @default(false)

  // ── Current sitting ─────────────────────────────────────────────────
  covers     Int? // guests on the open tab, for spend-per-head
  serverId   String?
  serverName String?

  reservations TableReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@map("tables")
}

// A self-service kiosk screen standing in the shop. Same shape as
// SignageDisplay and Table.qrToken: per-location, opened by an unguessable
// token, no login on the device.
//
// Kiosk orders are always walk-in collection — there is no table and no
// address to take — so the device carries no fulfilment choice at all.
model KioskDevice {
  id          String   @id @default(cuid())
  tenantId    String
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  brandId     String?
  name        String
  publicToken String   @unique
  isActive    Boolean  @default(true)
  // { allowCardPayment, allowPayAtCounter, categoryIds?, theme? }
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@map("kiosk_devices")
}

// A booking. Staff-made (phone / walk-up) or guest-made from the
// storefront when the location has online reservations switched on.
//
// tableId is NULLABLE on purpose: most restaurants take the booking
// first and decide the actual table on the day. An unassigned
// reservation still consumes capacity for its slot.
model TableReservation {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tableId    String?
  table      Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String?
  customerEmail String?
  partySize     Int
  startsAt      DateTime
  durationMins  Int       @default(90)
  // PENDING | CONFIRMED | SEATED | COMPLETED | CANCELLED | NO_SHOW
  status        String    @default("CONFIRMED")
  // ONLINE | STAFF | PHONE
  source        String    @default("STAFF")
  notes         String?
  // Set when the party is seated — links the booking to its tab so the
  // diary can show what they actually spent.
  orderId       String?
  seatedAt      DateTime?
  cancelledAt   DateTime?
  // Guest-facing reference ("R-7QK4M2") for confirmations + lookups.
  reference     String    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId, startsAt])
  @@index([tableId])
  @@index([status])
  @@map("table_reservations")
}

model KdsTicket {
  id          String    @id @default(cuid())
  kdsScreenId String
  screen      KdsScreen @relation(fields: [kdsScreenId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bumpedAt    DateTime?
  recalledAt  DateTime?
  // Phase KD — station routing + per-line cook state:
  //   { itemIds: string[]            // OrderItem ids routed to this station
  //     itemStates: { [orderItemId]: ISO done timestamp } }
  // Empty itemIds = the screen shows the whole order (no routing rules).
  metadata    Json      @default("{}")

  createdAt DateTime @default(now())

  @@unique([kdsScreenId, orderId])
  @@index([orderId])
  @@index([kdsScreenId, bumpedAt])
  @@map("kds_tickets")
}

// ── Printer ───────────────────────────────────────────────────────────────────
model Printer {
  id             String                @id @default(cuid())
  tenantId       String
  locationId     String
  location       Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name           String
  type           PrinterType
  connectionType PrinterConnectionType @default(LAN)
  // Phase AS-1 — used to be `station: PrinterStation` (enum). Now this
  // is just a classification ("what kind of station is this printer
  // associated with"); the row-shaped PrinterStation model owns real
  // routing decisions via defaultPrinterId.
  kind           PrinterStationKind    @default(KITCHEN)
  ipAddress      String?
  port           Int?
  isOnline       Boolean               @default(false)
  isActive       Boolean               @default(true)
  deletedAt      DateTime?

  failoverPrinterId String?

  // Phase AS-1 — physical-layer details for ESC/POS rendering. model
  // disambiguates vendor quirks (Epson vs Star vs Sunmi); paperWidth
  // drives column counts in the receipt template.
  model      String?
  paperWidth Int     @default(80)

  // Phase AS-1 — which agent currently drives this printer. Null for
  // SERVER_DIRECT printers (LAN printers the API can hit directly).
  agentId String?
  agent   PrintAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  supportsReceipts   Boolean @default(true)
  supportsKitchen    Boolean @default(false)
  supportsLabels     Boolean @default(false)
  supportsCut        Boolean @default(true)
  supportsCashDrawer Boolean @default(false)

  // Phase AS-2 — explicit capability columns so the Flutter / agent
  // client doesn't have to parse JSON to know which transports + ESC/POS
  // features this printer supports.
  supportsBluetooth Boolean @default(false)
  supportsUsb       Boolean @default(false)
  supportsLan       Boolean @default(true)
  supportsEscPos    Boolean @default(true)
  supportsQrCode    Boolean @default(true)
  supportsImages    Boolean @default(false)

  // Phase AS-1 — typed default render options:
  //   { copies, openCashDrawer, printLogo, largeFont, qrCode }
  defaults       Json @default("{}")
  autoPrintRules Json @default("[]")
  settings       Json @default("{}")
  metadata       Json @default("{}")

  printJobs            PrintJob[]
  stationsDefaultFor   PrinterStation[] @relation("StationDefaultPrinter")
  locationsReceiptFor  Location[]       @relation("LocationReceiptPrinter")
  locationsDispatchFor Location[]       @relation("LocationDispatchPrinter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([locationId, kind])
  @@index([locationId, type])
  @@index([locationId, isOnline])
  @@index([agentId])
  @@map("printers")
}

model PrintJob {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locationId    String
  printerId     String?
  printer       Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type          PrintJobType
  status        PrintJobStatus @default(QUEUED)
  payload       Json
  attempts      Int            @default(0)
  maxRetries    Int            @default(3)
  error         String?
  retryMetadata Json           @default("{}")
  printedAt     DateTime?

  // Phase AS-1 — routing + lifecycle additions.
  // stationId: which station this ticket belongs to (null for receipts).
  // trigger: which auto-print rule produced the job (or MANUAL_ONLY).
  // claimedByAgentId + claimedAt: held during the print window so two
  //   agents can't race the same job.
  // routeKey: indexed point lookup for the agent claim query
  //   ("locationId:abc|printerId:xyz").
  // idempotencyKey: clients replay POSTs after a network blip; this
  //   dedupes silently.
  // copies: drives multi-copy printing without spawning N jobs.
  stationId        String?
  station          PrinterStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  trigger          PrintTrigger?
  claimedByAgentId String?
  claimedByAgent   PrintAgent?     @relation(fields: [claimedByAgentId], references: [id], onDelete: SetNull)
  claimedAt        DateTime?
  routeKey         String?
  idempotencyKey   String?         @unique
  copies           Int             @default(1)

  // Phase AS-2 — retry + dead-letter columns. nextRetryAt scheduled by
  // markFailed() with exponential backoff; the cron picks up rows where
  // nextRetryAt <= now() and flips them QUEUED. deadLetteredAt set when
  // attempts >= maxRetries; those rows never auto-retry but still
  // appear in the dashboard for manual reprint. failureReason is a
  // short tag (`network`, `printer_offline`, `bad_payload`, …);
  // lastError carries the verbose message.
  nextRetryAt    DateTime?
  failureReason  String?
  deadLetteredAt DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([locationId, status])
  @@index([locationId, createdAt(sort: Desc)])
  @@index([printerId, status])
  @@index([orderId])
  @@index([stationId])
  @@index([claimedByAgentId])
  @@map("print_jobs")
}

// ── PrinterStation ─────────────────────────────────────────────────────
// Phase AS-1. First-class station rows, scoped to a location. Each
// station has a default printer that catches routed jobs. Routing
// precedence at job-creation time:
//   MenuItem → ModifierGroup → Category → Brand → Location → fallback
// Most-specific override wins.
model PrinterStation {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId       String
  location         Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name             String
  kind             PrinterStationKind @default(KITCHEN)
  defaultPrinterId String?
  defaultPrinter   Printer?           @relation("StationDefaultPrinter", fields: [defaultPrinterId], references: [id], onDelete: SetNull)
  isActive         Boolean            @default(true)
  sortOrder        Int                @default(0)

  menuItemRoutes      MenuItemStation[]
  categoryRoutes      MenuCategoryStation[]
  modifierGroupRoutes ModifierGroupStation[]
  brandDefaults       Brand[]                @relation("BrandDefaultStation")
  locationDefaults    Location[]             @relation("LocationDefaultKitchenStation")
  printJobs           PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, name])
  @@index([tenantId])
  @@index([locationId])
  @@map("printer_stations")
}

// ── PrintAgent ─────────────────────────────────────────────────────────
// Phase AS-1. A device runtime that claims + executes PrintJobs. Web
// bridge binary, Flutter mobile, Flutter desktop, or the API itself
// (SERVER_DIRECT) for LAN printers the API can reach.
model PrintAgent {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name          String
  kind          PrintAgentKind @default(WEB_BRIDGE)
  apiTokenHash  String
  capabilities  Json           @default("{}")
  versionString String?
  // Phase AS-3 — stable device identity. deviceId is a UUID the agent
  // generates locally on first boot; running the binary again with
  // the same config file reuses the same agent row. deviceName is the
  // human label ("Front-of-house Mac", "Kitchen Tablet").
  deviceId      String?        @unique
  deviceName    String?
  // Phase AS-2 — telemetry the operator dashboard reads to spot a sick
  // device without ssh-ing into it. osType: "macOS 14.5" / "Android 14"
  // / "Windows 11 Pro". hostname: machine name as the user knows it.
  // printerCount: how many printers the agent currently has handles to.
  osType        String?
  hostname      String?
  printerCount  Int            @default(0)
  lastSeenAt    DateTime?
  isActive      Boolean        @default(true)
  deletedAt     DateTime?

  printers    Printer[]
  claimedJobs PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([lastSeenAt])
  @@map("print_agents")
}

// ── AlertConfig ──────────────────────────────────────────────────────
// Phase AS-4. Per-(location, trigger) alert rule. Drives the dashboard
// sound + visual notification pipeline. Optional stationId narrows the
// rule to a single kitchen station.
model AlertConfig {
  id                     String       @id @default(cuid())
  tenantId               String
  locationId             String
  stationId              String?
  trigger                AlertTrigger
  enabled                Boolean      @default(true)
  soundUrl               String?
  volume                 Float        @default(1.0)
  repeatCount            Int          @default(1)
  repeatIntervalMs       Int          @default(5000)
  autoStopSeconds        Int?
  requireAcknowledgement Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@map("alert_configs")
}

model AlertAck {
  id               String       @id @default(cuid())
  tenantId         String
  locationId       String
  trigger          AlertTrigger
  referenceKey     String       @unique
  acknowledgedById String?
  acknowledgedAt   DateTime     @default(now())

  @@index([locationId])
  @@map("alert_acks")
}

enum AlertTrigger {
  NEW_ORDER
  ORDER_CANCELLED
  RIDER_ARRIVED
  SCHEDULED_ORDER_READY
  PRINTER_OFFLINE
  FAILED_PRINT
}

// ── AgentPairCode ────────────────────────────────────────────────────
// Phase AS-3. Short-lived pairing token. Operator generates one from
// the dashboard; the agent binary scans the QR (or the operator types
// the code) and POSTs it back to /v1/print-agents/pair to receive a
// permanent agent id + token.
model AgentPairCode {
  id          String    @id @default(cuid())
  tenantId    String
  locationId  String
  code        String    @unique
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  agentId     String?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([expiresAt])
  @@map("agent_pair_codes")
}

// ── Routing join tables ────────────────────────────────────────────────
// Phase AS-1. Most-specific-wins resolver walks these in order.
model MenuItemStation {
  id         String         @id @default(cuid())
  menuItemId String
  menuItem   MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stationId  String
  station    PrinterStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([menuItemId, stationId])
  @@index([menuItemId])
  @@index([stationId])
  @@map("menu_item_stations")
}

model ModifierGroupStation {
  id              String         @id @default(cuid())
  modifierGroupId String
  modifierGroup   ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  stationId       String
  station         PrinterStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@unique([modifierGroupId, stationId])
  @@index([modifierGroupId])
  @@index([stationId])
  @@map("modifier_group_stations")
}

model MenuCategoryStation {
  id         String         @id @default(cuid())
  categoryId String
  category   MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stationId  String
  station    PrinterStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([categoryId, stationId])
  @@index([categoryId])
  @@index([stationId])
  @@map("menu_category_stations")
}

model PrintTemplate {
  id         String       @id @default(cuid())
  tenantId   String
  locationId String?
  name       String
  type       PrintJobType
  template   Json
  isDefault  Boolean      @default(false)
  isActive   Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("print_templates")
}

// ── Driver / Dispatch ─────────────────────────────────────────────────────────
model Driver {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  firstName   String
  lastName    String
  phone       String
  email       String?
  isActive    Boolean @default(true)
  vehicleType String?
  metadata    Json    @default("{}")

  // Phase BG — home location. A driver belongs to one branch; the operator
  // board for a location lists its own drivers, and "All" lists every driver
  // across the operator's accessible locations. Null = unassigned (shows only
  // under "All").
  locationId String?
  location   Location? @relation("DriverHomeLocation", fields: [locationId], references: [id], onDelete: SetNull)

  // Phase BG — driver pay config. Earning for a shift = startupFee (once per
  // day worked) + the matched per-postcode fee for each delivery. postcodeFees
  // is [{ postcode, fee }]; an order's postcode is matched by LONGEST prefix
  // (normalised upper-case, spaces removed), so "DH2" covers "DH2 1DD" and an
  // exact "DH21DD" rule beats it.
  startupFee   Decimal @default(0) @db.Decimal(10, 2)
  postcodeFees Json    @default("[]")

  assignments DriverAssignment[]
  presence    DriverPresence?
  cashUps     DriverCashUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([locationId])
  @@map("drivers")
}

// Phase BG — a settled cash-up for one driver. Recording a cash-up snapshots
// the outstanding period's figures and advances the cleared marker: the next
// outstanding period starts at this row's periodEnd, so the same deliveries
// are never double-counted. cashHandover = cashCollected - driverEarning;
// negative means the RESTAURANT owes the driver for that period.
model DriverCashUp {
  id            String   @id @default(cuid())
  tenantId      String
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  locationId    String?
  periodStart   DateTime
  periodEnd     DateTime
  cashOrders    Int      @default(0)
  cashCollected Decimal  @default(0) @db.Decimal(10, 2)
  cardOrders    Int      @default(0)
  cardCollected Decimal  @default(0) @db.Decimal(10, 2)
  deliveries    Int      @default(0)
  driverEarning Decimal  @default(0) @db.Decimal(10, 2)
  cashHandover  Decimal  @default(0) @db.Decimal(10, 2)
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([tenantId, driverId, periodEnd])
  @@map("driver_cash_ups")
}

// ── DriverPresence (Phase AX — Dispatch) ──────────────────────────────────────
// One row per driver holding live operational state for the dispatch map and
// the Order Hub Driver app: online/offline, last-known GPS, which location they
// are clocked into, and the socket/push handles used to reach them. ON_JOB locks
// the driver from receiving new dispatches.
model DriverPresence {
  id         String               @id @default(cuid())
  driverId   String               @unique
  driver     Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tenantId   String
  locationId String? // location the driver is clocked into; null when OFFLINE
  status     DriverPresenceStatus @default(OFFLINE)

  lat     Float?
  lng     Float?
  heading Float?
  speed   Float?

  activeAssignmentId String? // set while ON_JOB — drives the "locked" state
  socketId           String?
  pushToken          String? // Expo push token for dispatch notifications
  lastPingAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, locationId, status])
  @@map("driver_presence")
}

enum DriverPresenceStatus {
  OFFLINE
  ONLINE
  ON_JOB
}

model DriverAssignment {
  id          String                 @id @default(cuid())
  orderId     String                 @unique
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId    String
  driver      Driver                 @relation(fields: [driverId], references: [id], onDelete: Restrict)
  status      DriverAssignmentStatus @default(ASSIGNED)
  // Phase AX — stop order on a multi-drop run (1,2,3…). Drives the "1/3" badge
  // in the driver app and the order the operator picked the orders on the map.
  sequence    Int?
  assignedAt  DateTime               @default(now())
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  arrivedAt   DateTime?
  deliveredAt DateTime?

  tracking DeliveryTracking[]

  @@index([driverId])
  @@index([driverId, status])
  @@map("driver_assignments")
}

model DeliveryTracking {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   DriverAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  accuracy     Float?
  heading      Float?
  speed        Float?
  event        String?

  recordedAt DateTime @default(now())

  @@index([assignmentId, recordedAt(sort: Desc)])
  @@map("delivery_tracking")
}

// Phase AX-4 — dispatch chat. Two channels share one table:
//   • DRIVER_OPERATOR — keyed by (tenantId, driverId): operator ↔ driver.
//   • CUSTOMER_DRIVER — keyed by orderId: the online-ordering customer ↔ driver.
// Realtime is polling-based (matches the storefront tracker), so no socket auth
// is needed on the driver app or the public customer page.
model ChatMessage {
  id         String  @id @default(cuid())
  tenantId   String
  channel    String // DRIVER_OPERATOR | CUSTOMER_DRIVER
  driverId   String?
  orderId    String?
  senderType String // OPERATOR | DRIVER | CUSTOMER
  senderName String?
  body       String

  createdAt        DateTime  @default(now())
  readByOperatorAt DateTime?
  readByDriverAt   DateTime?
  readByCustomerAt DateTime?

  @@index([tenantId, driverId, createdAt])
  @@index([orderId, createdAt])
  @@map("chat_messages")
}

// Phase AY — WhatsApp ordering. One row per (business number, customer phone):
// holds the in-progress cart + conversation state for the AI ordering bot. The
// customer is identified by their WhatsApp phone; the business is identified by
// the Meta phone_number_id (which maps to a location/integration).
model WhatsAppConversation {
  id            String  @id @default(cuid())
  tenantId      String
  locationId    String?
  brandId       String?
  // Customer's WhatsApp phone in E.164 (the conversation identity).
  waPhone       String
  // Meta business phone number id this conversation is on (maps to a location).
  phoneNumberId String?
  // IDLE | BROWSING | CART | CHECKOUT | AWAITING_PAYMENT
  state         String  @default("IDLE")
  // In-progress cart (items, modifiers, fulfillment, address).
  cart          Json?
  // Rolling chat transcript for the AI engine — last ~20 turns of
  // [{ role: "user" | "assistant", content }]. Trimmed on every write so it
  // never grows unbounded. Gives Claude multi-turn memory without re-deriving
  // state from the cart alone.
  messages      Json    @default("[]")
  customerName  String?
  lastOrderId   String?

  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([phoneNumberId, waPhone])
  @@index([tenantId, waPhone])
  @@map("whatsapp_conversations")
}

// ══════════════════════════════════════════════════════════════════════════════
// PHASE F — PAYMENT & FINANCIAL SYSTEM
// ══════════════════════════════════════════════════════════════════════════════

// Stripe Connect account per tenant (or per brand/location for multi-entity)
model StripeConnectAccount {
  id                 String  @id @default(cuid())
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Exactly one of these is set per row:
  //   tenant-level  → both null
  //   per-location  → locationId set (legacy AP-8 flow)
  //   per-brand     → brandId set (AW-30 embedded onboarding flow)
  locationId         String?
  brandId            String?
  stripeAccountId    String  @unique
  accountType        String  @default("EXPRESS")
  chargesEnabled     Boolean @default(false)
  payoutsEnabled     Boolean @default(false)
  defaultCurrency    String  @default("gbp")
  country            String  @default("GB")
  onboardingComplete Boolean @default(false)
  metadata           Json    @default("{}")

  payments Payment[]
  payouts  Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId])
  @@index([tenantId])
  @@index([brandId])
  @@map("stripe_connect_accounts")
}

// Immutable payment record — one per payment attempt
model Payment {
  id                     String                @id @default(cuid())
  tenantId               String
  orderId                String
  order                  Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  stripeConnectAccountId String?
  connectAccount         StripeConnectAccount? @relation(fields: [stripeConnectAccountId], references: [id], onDelete: SetNull)
  stripePaymentIntentId  String?               @unique
  stripeChargeId         String?               @unique
  /// Which provider took the money. Derived from the shop's country at
  /// charge time and STORED, unlike the live routing decision — a refund
  /// three months later has to go back through whoever actually took it,
  /// even if the shop has since moved country.
  provider               String                @default("STRIPE") // STRIPE | TAP
  /// The provider's own id for this charge. Tap's `charge.id` (chg_…); null
  /// on Stripe rows, which keep using the two columns above.
  providerChargeId       String?               @unique
  amount                 Decimal               @db.Decimal(10, 2)
  currency               String                @default("gbp")
  status                 PaymentRecordStatus
  method                 PaymentMethodType
  tipAmount              Decimal               @default(0) @db.Decimal(10, 2)
  platformFee            Decimal               @default(0) @db.Decimal(10, 2)
  processingFee          Decimal               @default(0) @db.Decimal(10, 2)
  netAmount              Decimal               @db.Decimal(10, 2)
  metadata               Json                  @default("{}")

  refunds       Refund[]
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("payments")
}

// Saved customer payment methods (Stripe PaymentMethod objects)
model PaymentMethod {
  id                    String            @id @default(cuid())
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stripePaymentMethodId String            @unique
  type                  PaymentMethodType
  last4                 String?
  brand                 String?
  expMonth              Int?
  expYear               Int?
  isDefault             Boolean           @default(false)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("payment_methods")
}

// Refund record — supports full and partial refunds
model Refund {
  id             String       @id @default(cuid())
  tenantId       String
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  stripeRefundId String?      @unique
  amount         Decimal      @db.Decimal(10, 2)
  reason         String?
  status         RefundStatus
  isPartial      Boolean      @default(false)
  processedBy    String?
  note           String?

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([paymentId])
  @@map("refunds")
}

// Append-only double-entry ledger — every financial event produces rows here
model LedgerEntry {
  id          String          @id @default(cuid())
  tenantId    String
  paymentId   String?
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refundId    String?
  refund      Refund?         @relation(fields: [refundId], references: [id], onDelete: SetNull)
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("gbp")
  description String
  reference   String?
  metadata    Json            @default("{}")

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([paymentId])
  @@map("ledger_entries")
}

// Stripe payout record
model Payout {
  id               String                @id @default(cuid())
  tenantId         String
  connectAccountId String?
  connectAccount   StripeConnectAccount? @relation(fields: [connectAccountId], references: [id], onDelete: SetNull)
  stripePayoutId   String                @unique
  amount           Decimal               @db.Decimal(10, 2)
  currency         String                @default("gbp")
  status           PayoutStatus
  arrivalDate      DateTime?
  description      String?
  metadata         Json                  @default("{}")

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("payouts")
}

// ══════════════════════════════════════════════════════════════════════════════
// PHASE F — INVENTORY & STOCK SYSTEM
// ══════════════════════════════════════════════════════════════════════════════

model Supplier {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  email    String?
  phone    String?
  address  Json?
  isActive Boolean @default(true)
  metadata Json    @default("{}")

  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("suppliers")
}

model Ingredient {
  id            String    @id @default(cuid())
  tenantId      String
  locationId    String
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name          String
  unit          String // "g", "ml", "each", "kg", "L"
  costPerUnit   Decimal   @db.Decimal(10, 4)
  lowStockAlert Int?
  isActive      Boolean   @default(true)
  metadata      Json      @default("{}")

  stockLevels  StockLevel[]
  recipeUsages RecipeIngredient[]
  movements    StockMovement[]
  poLines      PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, locationId])
  @@map("ingredients")
}

// Current stock level per ingredient per location (denormalised for fast reads)
model StockLevel {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  locationId   String
  quantity     Decimal    @db.Decimal(10, 3)

  updatedAt DateTime @updatedAt

  @@unique([ingredientId, locationId])
  @@index([locationId])
  @@map("stock_levels")
}

// Recipe definition — links a menu item to its required ingredients
model Recipe {
  id         String   @id @default(cuid())
  tenantId   String
  menuItemId String   @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  yields     Decimal  @default(1) @db.Decimal(6, 2) // portions per recipe batch

  ingredients RecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("recipes")
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal    @db.Decimal(10, 3) // per 1 unit of the dish

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// Append-only stock movement log — every change is auditable
model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  locationId      String
  ingredientId    String
  ingredient      Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  type            StockMovementType
  quantity        Decimal           @db.Decimal(10, 3) // positive = in, negative = out
  reason          String?
  orderId         String?
  purchaseOrderId String?
  recordedBy      String?
  metadata        Json              @default("{}")

  createdAt DateTime @default(now())

  @@index([tenantId, locationId, createdAt(sort: Desc)])
  @@index([ingredientId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  tenantId   String
  locationId String
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?
  totalCost  Decimal             @default(0) @db.Decimal(10, 2)
  notes      String?

  lines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, locationId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity        Decimal       @db.Decimal(10, 3)
  unitCost        Decimal       @db.Decimal(10, 4)
  totalCost       Decimal       @db.Decimal(10, 2)
  receivedQty     Decimal?      @db.Decimal(10, 3)

  @@index([purchaseOrderId])
  @@index([ingredientId])
  @@map("purchase_order_lines")
}

// ══════════════════════════════════════════════════════════════════════════════
// PHASE F — PUSH NOTIFICATION SYSTEM
// ══════════════════════════════════════════════════════════════════════════════

model DeviceToken {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  token    String         @unique
  platform DevicePlatform
  deviceId String?
  appId    String? // "driver", "kds", "pos", "manager"
  isActive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@map("device_tokens")
}

model NotificationLog {
  id       String              @id @default(cuid())
  tenantId String
  userId   String?
  type     NotificationType
  channel  NotificationChannel
  title    String
  body     String
  data     Json                @default("{}")
  status   String              @default("SENT")
  errorMsg String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("notification_logs")
}

// ══════════════════════════════════════════════════════════════════════════════
// PHASE F — WHITE-LABEL BRANDING
// ══════════════════════════════════════════════════════════════════════════════

model TenantBranding {
  id              String  @id @default(cuid())
  tenantId        String  @unique
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String  @default("#f97316")
  secondaryColor  String  @default("#1a1a2e")
  accentColor     String  @default("#fb923c")
  fontFamily      String  @default("Inter")
  customCss       String?
  appName         String?
  metaTitle       String?
  metaDescription String?
  emailFromName   String?
  emailFromAddr   String?
  emailFooterHtml String?
  senderSmsName   String?
  socialLinks     Json    @default("{}")

  customDomains CustomDomain[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_branding")
}

model CustomDomain {
  id         String         @id @default(cuid())
  tenantId   String
  brandingId String
  branding   TenantBranding @relation(fields: [brandingId], references: [id], onDelete: Cascade)
  domain     String         @unique
  status     DomainStatus   @default(PENDING)
  verifiedAt DateTime?
  sslAt      DateTime?
  txtRecord  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("custom_domains")
}

// ══════════════════════════════════════════════════════════════════════════════
// PHASE F — SUBSCRIPTIONS & BILLING
// ══════════════════════════════════════════════════════════════════════════════

model SubscriptionPlan {
  id               String  @id @default(cuid())
  name             String  @unique // "STARTER", "PROFESSIONAL", "ENTERPRISE"
  displayName      String
  stripePriceId    String? @unique
  pricePerMonth    Decimal @db.Decimal(10, 2)
  pricePerLocation Decimal @default(0) @db.Decimal(10, 2)
  maxLocations     Int?
  maxUsers         Int?
  features         Json    @default("[]") // feature flag keys
  isActive         Boolean @default(true)

  subscriptions TenantSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

model TenantSubscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  stripeSubId        String?            @unique
  stripeCustomerId   String?
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt        DateTime?
  locationCount      Int                @default(1)
  metadata           Json               @default("{}")

  // Phase R billing fields
  billingEmail        String? // billing contact — may differ from owner email
  paymentMethodStatus String? // "ok" | "expiring_soon" | "expired" | "missing"
  lastInvoiceStatus   String? // mirrors InvoiceStatus of last invoice
  gracePeriodEndsAt   DateTime? // set when payment fails; UNPAID after this date

  invoices     Invoice[]
  usageRecords UsageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("tenant_subscriptions")
}

// Phase AW-30 — per-location SaaS subscription billed by the platform.
// Distinct from TenantSubscription (which is tenant-wide). Each row
// represents one shop the platform charges a flat monthly amount.
// Card collection + invoice list + PDF download all flow through
// the Stripe Customer Portal so we don't rebuild what Stripe gives
// us; this row just mirrors the bits we need to render in our own
// UI (status pill, next charge date, monthly amount).
model MerchantSubscription {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId String   @unique
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Stripe handles
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String? // a per-merchant Price we mint at create time
  stripeCheckoutId     String? // most recent Checkout Session id for collecting card

  // Pricing
  monthlyAmountPence Int // platform fee in pence, e.g. 4900 for £49/month
  currency           String @default("gbp")

  // Status — mirrors Stripe's, updated by webhook
  status              String    @default("incomplete") // incomplete | active | past_due | canceled | unpaid | trialing
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean   @default(false)
  trialEndsAt         DateTime?
  defaultPaymentBrand String? // "visa", "mastercard" — for the "Card on file" line
  defaultPaymentLast4 String?
  lastInvoiceStatus   String? // paid | open | uncollectible | void
  lastFailureMessage  String? // human-readable reason from invoice.payment_failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("merchant_subscriptions")
}

model Invoice {
  id              String             @id @default(cuid())
  tenantId        String
  subscriptionId  String
  subscription    TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  stripeInvoiceId String?            @unique
  number          String             @unique
  status          InvoiceStatus
  amountDue       Decimal            @db.Decimal(10, 2)
  amountPaid      Decimal            @default(0) @db.Decimal(10, 2)
  currency        String             @default("gbp")
  dueDate         DateTime?
  paidAt          DateTime?
  pdfUrl          String?

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([subscriptionId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ── Phase R: Usage Tracking ───────────────────────────────────────────────────
// Monthly aggregate of billable events per tenant per location.
// Written by a nightly cron — never in the order hot path.
model UsageRecord {
  id               String             @id @default(cuid())
  tenantId         String
  subscriptionId   String
  subscription     TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  locationId       String
  billingMonth     DateTime           @db.Date // first day of the month
  orderCount       Int                @default(0)
  printJobCount    Int                @default(0)
  activeProviders  Int                @default(0)
  reportedToStripe Boolean            @default(false)
  reportedAt       DateTime?
  metadata         Json               @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, locationId, billingMonth])
  @@index([tenantId, billingMonth(sort: Desc)])
  @@index([subscriptionId])
  @@map("usage_records")
}

// ── Phase R: Stripe Webhook Idempotency Log ───────────────────────────────────
// Every Stripe event we receive is stored here before processing.
// If stripeEventId already exists → skip (idempotent).
model StripeWebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique // stripe evt_xxx
  type          String
  processedAt   DateTime?
  error         String?
  payload       Json

  receivedAt DateTime @default(now())

  @@index([type, receivedAt(sort: Desc)])
  @@map("stripe_webhook_events")
}

