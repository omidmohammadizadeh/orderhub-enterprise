// ── AI Video Studio ──────────────────────────────────────────────────────────
// Paid add-on: merchants generate short marketing videos from a product photo
// + description via an AI model (Replicate). Monetised with credits — an add-on
// subscription grants a monthly allowance (resets each period) and extra videos
// are prepaid top-up packs. Each generation debits one credit BEFORE the
// provider is called and refunds it if the render fails, so a merchant can
// never spend past their balance.

enum VideoGenStatus {
  QUEUED
  RENDERING
  READY
  FAILED
}

enum VideoCreditReason {
  GRANT
  TOPUP
  DEBIT
  REFUND
  ADJUST
}

model VideoStudioAccount {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  // Add-on entitlement — flipped on by the Stripe add-on subscription webhook.
  addonActive          Boolean   @default(false)
  stripeSubscriptionId String?   @unique
  // Monthly included allowance (reset each billing period) vs purchased
  // top-ups (persist). Total spendable = includedBalance + topupBalance.
  includedMonthly      Int       @default(0)
  includedBalance      Int       @default(0)
  topupBalance         Int       @default(0)
  lastGrantAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("video_studio_accounts")
}

model VideoCreditTxn {
  id           String            @id @default(cuid())
  tenantId     String
  delta        Int // +credit, -debit
  reason       VideoCreditReason
  source       String? // "included" | "topup" for debits
  generationId String?
  note         String?
  createdAt    DateTime          @default(now())

  @@index([tenantId, createdAt])
  @@map("video_credit_txns")
}

model VideoGeneration {
  id                    String         @id @default(cuid())
  tenantId              String
  userId                String?
  locationId            String?
  brandId               String?
  status                VideoGenStatus @default(QUEUED)
  // "VIDEO" | "IMAGE" — the Studio generates both; images reuse the exact
  // same credit/debit/refund + reconcile pipeline, only the output type and
  // the model differ. Plain string (not an enum) to avoid an enum migration.
  kind                  String         @default("VIDEO")
  model                 String
  prompt                String
  // For a video this is the source/first-frame photo; for an image it's the
  // OPTIONAL reference sample (empty string when generating from text only).
  sourceImageUrl        String
  resultUrl             String?
  replicatePredictionId String?
  creditsCost           Int            @default(1)
  error                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("video_generations")
}

// Phase — SMS metering. One row per SMS we send on a tenant's behalf (payment
// links, marketing). This is the billable ledger: pass-through billing totals
// each restaurant's usage per period from here. Body is intentionally NOT
// stored (privacy) — only the recipient, purpose, and segment count for cost.
model SmsMessage {
  id          String   @id @default(cuid())
  tenantId    String
  locationId  String?
  brandId     String?
  orderId     String?
  toNumber    String
  purpose     String // PAYMENT_LINK | MARKETING | OTHER
  campaignId  String? // marketing_sms_campaigns.id for MARKETING sends
  segments    Int      @default(1) // SMS parts (drives cost)
  provider    String   @default("TWILIO")
  providerSid String? // Twilio message SID
  status      String // SENT | FAILED
  error       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, locationId, createdAt])
  @@map("sms_messages")
}

// Phase — Marketing SMS. A consented audience the tenant can broadcast to.
// One row per unique phone (E.164) per tenant. Consent is first-class: only
// OPTED_IN contacts are ever messaged, STOP replies flip to OPTED_OUT for good,
// and imports never re-opt-in someone who opted out. This is what keeps the
// channel UK PECR / ICO compliant.
model MarketingContact {
  id         String  @id @default(cuid())
  tenantId   String
  // The location this contact belongs to — SMS marketing is location-scoped so
  // each site markets to its own customers. null = tenant-wide (admin imports
  // with no location selected). Part of the dedupe key.
  locationId String?
  phone      String // E.164, e.g. +447700900123 — the dedupe key
  firstName  String?
  lastName   String?
  email      String?
  // Where this contact came from: an OrderSource channel (POS/ONLINE/WHATSAPP/…)
  // or an import (CSV/EXCEL/GOOGLE_SHEET/PDF/PASTE/MANUAL).
  source     String?
  customerId String? // links to the CRM Customer row when imported from the DB

  consentStatus  String    @default("OPTED_IN") // OPTED_IN | OPTED_OUT | UNKNOWN
  consentSource  String? // how consent was captured (channel / import / manual)
  consentAt      DateTime?
  unsubscribedAt DateTime? // set when they reply STOP — suppression is permanent

  tags           String[]
  lastCampaignAt DateTime?
  createdBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, locationId, phone])
  @@index([tenantId, consentStatus])
  @@index([tenantId, locationId, consentStatus])
  @@index([tenantId, source])
  @@map("marketing_contacts")
}

// A broadcast. Composed as a draft, then sent to the matching opted-in audience
// with per-recipient wallet debits. Counts + cost snapshot the send for history.
model MarketingSmsCampaign {
  id           String  @id @default(cuid())
  tenantId     String
  locationId   String? // the location this campaign markets to (audience scope)
  name         String
  senderHeader String? // prepended to the body, e.g. "Pizza Uno"
  body         String

  status   String @default("DRAFT") // DRAFT | SENDING | SENT | FAILED
  audience Json   @default("{}") // { sources?: string[], tags?: string[] }

  recipientCount Int @default(0)
  sentCount      Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)
  segments       Int @default(0) // total segments actually sent
  costMinor      Int @default(0) // total wallet spend (pennies)

  createdBy   String?
  startedAt   DateTime?
  completedAt DateTime?

  recipients MarketingSmsRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@map("marketing_sms_campaigns")
}

// One row per intended recipient of a campaign — the send log + in-campaign
// dedupe (unique [campaignId, phone] means a number can't be texted twice by
// the same blast even if it appears in the audience more than once).
model MarketingSmsRecipient {
  id           String               @id @default(cuid())
  campaignId   String
  campaign     MarketingSmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenantId     String
  contactId    String?
  phone        String
  status       String // SENT | FAILED | SKIPPED
  reason       String? // opted_out | duplicate | insufficient_balance | error text
  segments     Int                  @default(0)
  smsMessageId String?

  createdAt DateTime @default(now())

  @@unique([campaignId, phone])
  @@index([campaignId])
  @@map("marketing_sms_recipients")
}

// Phase — Prepaid SMS wallet. Restaurants top up a GBP balance up front; every
// billable SMS (payment links, marketing) debits it per Twilio segment. This is
// how OrderHub charges for SMS WITHOUT fronting Twilio costs — no send happens
// unless the balance covers it. Balance is stored in MINOR units (pennies) as an
// integer to avoid float drift. One wallet per tenant.
model Wallet {
  id         String  @id @default(cuid())
  tenantId   String
  // Location this wallet funds. null = the tenant-wide wallet (admin / sends
  // with no location). SMS marketing + payment-link SMS are location-scoped, so
  // each site funds and spends its own balance.
  locationId String?
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  balanceMinor Int    @default(0) // pennies (GBP); may dip slightly negative on a rare multi-segment send
  currency     String @default("GBP")

  // Per-tenant price per SMS segment (pennies). null → the platform default
  // (SMS_PRICE_PER_SEGMENT_MINOR env, default 7p). Lets us give bespoke rates.
  smsPricePerSegmentMinor  Int?
  // Per-tenant price per answered AI voice call (pennies). null → the platform
  // default (VOICE_PRICE_PER_CALL_MINOR env, default 100p). Per CALL, not per
  // minute: our own cost is per-conversation-turn rather than per-second, and a
  // per-minute price would bill the shop for our agent being slow.
  voicePricePerCallMinor   Int?
  // Warn the operator when balance drops below this (pennies). Default £2.
  lowBalanceThresholdMinor Int  @default(200)

  // Platform-account Stripe customer, reused across top-ups (created lazily).
  stripeCustomerId String?

  // ── Auto top-up ────────────────────────────────────────────────────────
  // An empty wallet means the AI stops answering the phone — silently, at the
  // busiest hour, and the shop won't find out until Monday. Auto top-up is what
  // stops that happening, so the saved card is part of the product, not a
  // convenience.
  autoTopupEnabled        Boolean @default(false)
  // Refill when the balance drops below this (pennies). Default £10.
  autoTopupThresholdMinor Int     @default(1000)
  // How much to add each time (pennies). Default £20.
  autoTopupAmountMinor    Int     @default(2000)
  // Card saved off-session at the first manual top-up (setup_future_usage).
  stripePaymentMethodId   String?
  // Throttle: never fire two auto top-ups inside the cooldown, so a bug or a
  // burst of calls can't drain the operator's card.
  autoTopupLastAt         DateTime?
  // A declined card must be VISIBLE — otherwise the first anyone knows is the
  // phone going quiet. Cleared on the next success.
  autoTopupFailedAt       DateTime?
  autoTopupFailureReason  String?

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, locationId])
  @@map("wallets")
}

// Immutable ledger of every wallet movement. amountMinor is SIGNED: credits
// (top-ups) positive, debits (SMS sends) negative. balanceAfterMinor snapshots
// the running balance for an at-a-glance statement + reconciliation.
model WalletTransaction {
  id       String @id @default(cuid())
  tenantId String
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type              String // TOPUP | DEBIT | REFUND | ADJUSTMENT
  amountMinor       Int // signed pennies (+credit / -debit)
  balanceAfterMinor Int
  currency          String @default("GBP")

  // Context for statement lines + reconciliation.
  purpose               String? // SMS_PAYMENT_LINK | SMS_MARKETING | SMS_OTHER | TOPUP | DISPATCH_FEE | VOICE_CALL
  segments              Int? // for SMS debits — how many parts were charged
  smsMessageId          String? // links to the sms_messages row
  orderId               String? // DISPATCH_FEE debits — the dispatched order
  // VOICE_CALL debits. Unique: the billing hook can fire more than once for a
  // call (provider webhook retries, a reconnect), and the database is the only
  // honest place to make "one call, one charge" true.
  voiceCallId           String? @unique
  locationId            String?
  stripeCheckoutId      String?
  stripePaymentIntentId String? // top-ups — idempotency key for webhook credit
  description           String?
  createdBy             String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([walletId, createdAt])
  @@index([stripePaymentIntentId])
  @@map("wallet_transactions")
}

// Per-location Stuart (last-mile courier) integration. The restaurant plugs in
// its OWN Stuart client_id/secret so Stuart bills their account directly for the
// courier; OrderHub only takes a flat per-dispatch fee from the location wallet.
// One row per location; dispatch is gated on `active`.
model StuartConfig {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String   @unique
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // "sandbox" (bot couriers, api.sandbox.stuart.com) | "production".
  environment    String  @default("sandbox")
  // Encrypted { clientId, clientSecret } envelope (CredentialEncryptionService).
  credentials    Json
  // Shared secret we hand to Stuart as the webhook auth header value; the
  // receiver rejects any callback whose header doesn't match. Generated on save.
  webhookAuthKey String
  // Master on/off for this location. Dispatch refuses when false or unset.
  active         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stuart_configs")
}

// Per-location Uber Direct (DaaS) integration. Same model as Stuart — the
// restaurant plugs in its OWN Uber Direct account so Uber bills them directly;
// OrderHub only takes a flat per-dispatch fee from the location wallet. The
// extra field vs Stuart is customerId (Uber puts it in the API URL path).
model UberDirectConfig {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String   @unique
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // "sandbox" (test mode) | "production".
  environment String  @default("sandbox")
  // Encrypted { customerId, clientId, clientSecret, signingKey } envelope.
  // signingKey verifies inbound webhooks (HMAC-SHA256 of the raw body).
  credentials Json
  active      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("uber_direct_configs")
}

// Customer reviews of a completed order. Deliberately scalar-only (no Prisma
// relation fields) so adding it doesn't touch Order/Location/Brand — those
// models are large and edited often, and a stray duplicate field there breaks
// every build.
//
// One review per order, enforced by the unique orderId: the review is earned
// by an actual purchase, which is the whole point versus an open review site.
model Review {
  id           String    @id @default(cuid())
  tenantId     String
  // The order being reviewed. Unique — a customer reviews an order once.
  orderId      String    @unique
  locationId   String
  brandId      String?
  customerId   String?
  // Display name captured at submit time. Denormalised on purpose: the review
  // should keep reading "Bruce" even if that customer record is later merged
  // or deleted.
  customerName String?
  rating       Int // 1..5
  comment      String?
  // PUBLISHED — visible on the storefront. HIDDEN — kept for the operator's
  // records but not shown publicly.
  status       String    @default("PUBLISHED")
  // Operator's public response.
  reply        String?
  repliedAt    DateTime?
  repliedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, createdAt])
  @@index([locationId, status])
  @@index([brandId, status])
  @@map("reviews")
}

// A shared basket several people add to before it becomes one order.
//
// Scalar-only relations on purpose (same as Review): Order/Location/Brand are
// large, frequently-edited models and a stray duplicate field there breaks
// every build.
//
// The basket is NOT an Order. It becomes one only when the host places it, so
// an abandoned group order never reaches the kitchen or the order board.
// One inbound phone call handled by the AI receptionist.
//
// Written the moment the call arrives — BEFORE we decide whether to answer — so
// a refused-for-no-funds call is still a row the operator can see. That matters
// more than it sounds: the failure mode we're designing against is a phone that
// quietly stops being answered, and a row here is the difference between the
// shop finding out on the dashboard and finding out from an angry customer.
//
// Scalar-only relations, same reasoning as GroupOrder/Review: Order, Location
// and Brand are large and edited often, and a duplicate field on them has
// broken builds before.
model VoiceCall {
  id         String  @id @default(cuid())
  tenantId   String
  locationId String
  brandId    String?

  // The provider's handle for the call (Telnyx call_control_id). Unique so a
  // replayed webhook updates the existing row rather than forking a second one.
  providerCallId String? @unique
  provider       String  @default("TELNYX")

  fromNumber String?
  toNumber   String?
  direction  String  @default("INBOUND")

  // RINGING — arrived, not yet answered.
  // ANSWERED — the AI picked up and the conversation ran.
  // COMPLETED — ended normally.
  // NOT_ANSWERED — we deliberately didn't pick up (no funds / AI disabled /
  //   outside hours). The caller keeps ringing at the shop exactly as they did
  //   before the AI existed, so this is a degraded state, never a lost call.
  // TRANSFERRED — handed to a human.
  // FAILED — something broke on our side.
  status String @default("RINGING")

  // Why we didn't answer, when status is NOT_ANSWERED. NO_FUNDS is the one the
  // operator needs surfaced loudly.
  notAnsweredReason String?

  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  // What the call was actually for — this is what the "recovered calls" figure
  // on the dashboard is built from, and what justifies the per-call price.
  // ORDER | RESERVATION | ORDER_STATUS | ENQUIRY | TRANSFERRED | ABANDONED
  outcome       String?
  orderId       String?
  reservationId String?
  // Was the shop's own line unanswered when this arrived? Set by the
  // forward-on-no-answer path — the honest definition of a recovered call.
  wasOverflow   Boolean @default(false)

  // Billing. billedMinor is null until the call is charged; a call can be
  // answered and still never billed (too short to bill for).
  billedMinor Int?
  billedAt    DateTime?

  // Full turn-by-turn record. The operator can read what the AI told their
  // customer — non-negotiable for trust in a system that speaks for them.
  transcript Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([locationId, createdAt])
  @@index([locationId, status])
  @@map("voice_calls")
}

model GroupOrder {
  id       String @id @default(cuid())
  tenantId String
  // Public join token — what the share link carries. Indexed and unique
  // because every guest request looks the basket up by it.
  token      String  @unique
  locationId String
  brandId    String?
  // Whoever opened it. Nullable: a guest host may not have an account.
  hostCustomerId String?
  hostName       String?
  // The host's browser-scoped ref — same shape as GroupOrderItem.addedByRef.
  // Closing, placing and cancelling the basket are host-only actions, and with
  // no login this ref is the only credential there is. It is NEVER returned in
  // the public view: any guest who could read it could place the order.
  hostRef String?
  // OPEN — still accepting items. LOCKED — host closed it, paying.
  // PLACED — became an order. EXPIRED / CANCELLED — never will.
  status String @default("OPEN")
  // Set once placed, so the basket and its order can be reconciled.
  orderId String? @unique
  // DELIVERY | PICKUP — chosen by the host up front because it changes the
  // fees everyone is splitting.
  fulfillmentType String @default("DELIVERY")
  // HOST_PAYS — host settles the whole basket. SPLIT — each guest pays for
  // their own lines before it can be placed.
  paymentMode String @default("HOST_PAYS")
  // Abandoned baskets are common; without an expiry they accumulate forever
  // holding promo allocations.
  expiresAt DateTime?
  placedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([locationId, status])
  @@map("group_orders")
}

// One person's line in a shared basket. Mirrors the cart-item shape the
// storefront already builds, plus who added it — that attribution is what
// makes the kitchen ticket baggable per person.
model GroupOrderItem {
  id           String @id @default(cuid())
  groupOrderId String
  // Guest identity is a name, not an account — people join by link.
  addedByName String
  // Stable per-guest id (browser-scoped) so someone can edit or remove their
  // OWN lines without being able to touch anyone else's.
  addedByRef String
  // The cart line as the storefront composes it (product, size, modifiers,
  // notes). Kept as JSON so this stays in step with cart changes without a
  // migration each time.
  cartItem Json
  quantity Int    @default(1)
  // Modifier-inclusive line total in pounds, as the storefront calculated it.
  lineTotal Float
  // Locked once this guest has paid for their share — a later edit would
  // change an amount that has already been charged.
  isPaid    Boolean   @default(false)
  paidAt    DateTime?
  paymentId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([groupOrderId])
  @@index([groupOrderId, addedByRef])
  @@map("group_order_items")
}

// ══════════════════════════════════════════════════════════════════════════════
// PHASE AX — CUSTOMER WEB PUSH (PWA order updates)
// ══════════════════════════════════════════════════════════════════════════════

// A customer's browser, subscribed to hear about their order.
//
// Distinct from WebPushSubscription, which is keyed on userId and belongs to
// staff. Customers have no account most of the time — they are a phone number
// and a browser — so the credential here is the endpoint itself, which the
// push service issues per browser install and which nobody else can guess.
//
// Deliberately NOT keyed on a login: making people sign in to hear that their
// pizza is ready would lose most of the audience the feature exists for.
model CustomerPushSubscription {
  id         String  @id @default(cuid())
  tenantId   String
  locationId String?
  brandId    String?

  // Issued by the browser's push service. Unique because re-subscribing the
  // same install must update the row, not accumulate duplicates that would
  // each fire a separate buzz for one order.
  endpoint String @unique
  p256dh   String
  auth     String

  // Set when the customer happens to be signed in — then every future order of
  // theirs is covered without re-subscribing.
  customerId String?
  // Browser-scoped id, same shape as GroupOrderItem.addedByRef.
  deviceRef String?
  userAgent String?

  isActive Boolean @default(true)
  // Stamped when the push service reports the endpoint is gone (404/410).
  // Kept rather than deleted so we can tell "unsubscribed" from "never asked".
  revokedAt  DateTime?
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders CustomerPushOrder[]

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_push_subscriptions")
}

// Which orders a given browser wants to hear about.
//
// A link table rather than an orderId column on the subscription: one phone
// legitimately tracks more than one order at a time (a household ordering
// twice, a host watching a group order), and overwriting a single pointer
// would silently stop notifying the earlier one.
model CustomerPushOrder {
  id             String @id @default(cuid())
  subscriptionId String
  orderId        String

  // Where to send the customer when they tap the notification.
  //
  // Supplied by the browser at subscribe time rather than derived on the
  // server, because the page KNOWS its own URL and the server can only guess
  // — and it guessed wrong: a location with no slug produced a path with no
  // matching route, so every tap opened a 404. It also makes brand custom
  // domains work, where the storefront is not under /order/<slug> at all.
  // Validated as a relative path on the way in; never trusted as a full URL.
  trackPath String?

  createdAt DateTime @default(now())

  subscription CustomerPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, orderId])
  @@index([orderId])
  @@map("customer_push_orders")
}

// ── Contracts (e-signature) ───────────────────────────────────────────────────
//
// Sending a client an agreement, proving they signed it, and — when the
// agreement is a subscription — letting them start paying from the same page.
//
// The legal weight of an e-signature under the UK Electronic Communications
// Act comes from EVIDENCE, not from the picture of a squiggle: who opened it,
// from where, when, and that they acted deliberately. That is why every
// transition is written to ContractEvent with IP and user-agent, and why the
// signed body is frozen onto the Contract row rather than read back through
// the template (which the operator can edit afterwards).

model ContractTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // Two kinds of template, mutually exclusive:
  //  • bodyHtml — written in the dashboard editor, rendered as the signable
  //    page itself, and the only kind that supports {{placeholders}}.
  //  • fileUrl  — an uploaded PDF shown in a viewer above the signature block.
  bodyHtml String?
  fileUrl  String?
  fileName String?
  fileType String?

  /// Pre-fills the contract's subscription offer when one is built from this.
  subscriptionAmountPence Int?

  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  contracts Contract[]

  @@index([tenantId])
  @@map("contract_templates")
}

model Contract {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId String?
  template   ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Which location this agreement covers — drives the Subscribe button.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  title String

  // Frozen at send time. Editing the template afterwards must never change
  // what a counterparty already put their name to.
  bodyHtml String?

  /// The template wording BEFORE placeholders were substituted, kept so an
  /// amendment can re-render the body with new figures.
  ///
  /// Without it, changing an agreed fee after sending is impossible: the
  /// rendered body has "£49.00" where the placeholder used to be, and there
  /// is nothing left to substitute into. Re-fetching the template instead
  /// would be worse — it would silently pull in every unrelated edit made to
  /// that template since, changing clauses nobody meant to touch.
  sourceHtml String?
  fileUrl  String?
  fileName String?
  fileType String?

  recipientName    String
  recipientEmail   String
  recipientCompany String?

  /// Counterparty detail that appears in the agreement's parties clause.
  /// Optional throughout: a sole trader has no company number, and a contract
  /// should not be blocked on a field the client does not have. The matching
  /// {{#…}} sections drop the line when it is blank rather than printing a
  /// dangling label.
  recipientCompanyNumber String?
  recipientAddress       String?
  recipientPhone         String?

  /// How many premises the subscription covers. Drives the per-location
  /// wording — "per location" reads oddly on an agreement for exactly one.
  locationCount Int?

  /// Set = the signed contract offers a subscription at this monthly price.
  subscriptionAmountPence Int?

  /// Commission we take on each order, as a percentage (e.g. 2.5 = 2.5%).
  /// Null means no commission clause appears in the agreement at all — the
  /// section is removed rather than printed as "0%", which would read as a
  /// term that was negotiated to zero rather than one that does not apply.
  commissionPercent Float?

  /// Per-order service charge the CUSTOMER pays at checkout, in pence.
  /// Null removes the clause, same reasoning as commission.
  customerServiceChargePence Int?

  // Who the agreement is FROM, shown on the signature certificate. Null =
  // platform defaults; a partial object overrides field by field, so an
  // operator can issue on behalf of another entity without reconfiguring.
  issuer Json?

  // DRAFT → SENT → OPENED → SIGNED, or VOIDED from anywhere before SIGNED.
  status String @default("DRAFT")

  /// The link IS the credential — long, random, unguessable.
  token String @unique

  sentAt         DateTime?
  firstOpenedAt  DateTime?
  signedAt       DateTime?
  voidedAt       DateTime?
  lastRemindedAt DateTime?

  // Signature evidence
  signerName        String?
  signerEmail       String?
  signatureImageUrl String?
  signerIp          String?
  signerUserAgent   String?

  /// Stamped when the signer starts checkout from the contract.
  subscriptionStartedAt DateTime?

  createdByUserId String?
  /// Soft delete. A signed contract is the record of an agreement somebody is
  /// bound by, and its audit trail is the evidence behind it — a hard DELETE
  /// would destroy both to tidy a list. Removing it hides it from the
  /// operator and stops the signing link working; the row survives.
  deletedAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events ContractEvent[]

  @@index([tenantId, status])
  @@index([locationId])
  @@map("contracts")
}

model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  /// CREATED | SENT | OPENED | SIGNED | VOIDED | REMINDED | SUBSCRIBE_STARTED
  type      String
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([contractId, createdAt])
  @@map("contract_events")
}
