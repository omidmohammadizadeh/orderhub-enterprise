// ─────────────────────────────────────────────────────────────────────────────
// OrderHub Enterprise — Prisma Schema v3 (Phase E)
// Multi-tenant omnichannel restaurant integration platform
//
// Design principles:
//  1. tenantId is ALWAYS denormalised on write-heavy tables to avoid JOINs
//     at query time. The application enforces tenant isolation at the service
//     layer; RLS can be added at the Postgres level in a future phase.
//  2. Soft-delete (deletedAt) is used only for configuration entities that
//     operators manage (brands, locations, menus, printers, integrations).
//     Transactional records (orders, webhooks, print jobs, audit logs) are
//     NEVER soft-deleted — they are archived or retained per policy instead.
//  3. Cascade rules are explicit on every FK:
//       - Cascade: child record has no independent identity (e.g. OrderItem)
//       - Restrict: FK prevents accidental parent deletion (e.g. Order→Tenant)
//       - SetNull: FK becomes nullable when parent removed (e.g. PrintJob→Printer)
//  4. All timeline/audit columns are written ONCE; updatedAt is omitted from
//     immutable records (OrderStatusHistory, AuditLog, WebhookEvent, OrderItem)
//     to make immutability explicit rather than implicit.
//  5. customerPhone and customerName are extracted from customerInfo JSON to
//     support indexed searches without computed columns or GIN indexes.
//  6. Partitioning preparation: orders are keyed (tenantId, createdAt) and all
//     composite indexes lead with tenantId or locationId to match future
//     Postgres RANGE partitioning by created_at within tenant shards.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["fullTextSearch", "metrics"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ── Tenant (Organisation) ─────────────────────────────────────────────────────
model Tenant {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  plan     TenantPlan   @default(STARTER)
  status   TenantStatus @default(ACTIVE)
  settings Json         @default("{}")
  metadata Json         @default("{}")

  brands     Brand[]
  users      User[]
  apiKeys    ApiKey[]
  orders     Order[]
  printJobs  PrintJob[]
  customers  Customer[]
  promoCodes PromoCode[]
  drivers    Driver[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

// ── User ──────────────────────────────────────────────────────────────────────
model User {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String    @unique
  password    String?
  firstName   String
  lastName    String
  avatarUrl   String?
  role        UserRole  @default(VIEWER)
  permissions String[]  @default([])
  isActive    Boolean   @default(true)
  isVerified  Boolean   @default(false)
  lastLoginAt DateTime?

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, isActive])
  @@map("users")
}

// ── RefreshToken ──────────────────────────────────────────────────────────────
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── OAuthAccount ──────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?
  rawProfile        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ── ApiKey ────────────────────────────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("api_keys")
}

// ── AuditLog ──────────────────────────────────────────────────────────────────
model AuditLog {
  id         String  @id @default(cuid())
  tenantId   String
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  event      String
  resource   String?
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  meta       Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
  @@index([userId])
  @@index([event])
  @@map("audit_logs")
}

// ── Brand ─────────────────────────────────────────────────────────────────────
model Brand {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  logoUrl   String?
  settings  Json      @default("{}")
  metadata  Json      @default("{}")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  locations      Location[]
  menus          Menu[]
  modifierGroups ModifierGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("brands")
}

// ── Location ──────────────────────────────────────────────────────────────────
model Location {
  id          String    @id @default(cuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  externalRef String?
  address     Json
  phone       String?
  timezone    String    @default("Europe/London")
  isActive    Boolean   @default(true)
  settings    Json      @default("{}")
  metadata    Json      @default("{}")
  deletedAt   DateTime?

  integrations Integration[]
  orders       Order[]
  printers     Printer[]
  kdsScreens   KdsScreen[]

  // Online ordering
  slug           String? @unique
  openingHours   Json    @default("[]")
  deliveryConfig Json    @default("{}")
  onboardingStep Int     @default(0)

  // ── Store Operations ──────────────────────────────────
  isOpen          Boolean   @default(true)   // current open/closed state
  isPaused        Boolean   @default(false)  // temporarily pausing new orders
  pauseUntil      DateTime?                  // auto-resume at this time
  busyMode        Boolean   @default(false)  // kitchen busy — shows extended wait
  currentPrepTime Int       @default(20)     // quoted prep time in minutes
  throttleLimit   Int?                       // max new orders per hour (null = unlimited)
  storeStatusNote String?                    // displayed to customers when paused/closed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, deletedAt])
  @@map("locations")
}

// ── Integration ───────────────────────────────────────────────────────────────
model Integration {
  id           String              @id @default(cuid())
  tenantId     String
  locationId   String
  location     Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  platform     IntegrationPlatform
  status       IntegrationStatus   @default(INACTIVE)
  credentials  Json
  settings     Json                @default("{}")
  webhookUrl   String?
  syncMetadata Json                @default("{}")
  lastSyncAt   DateTime?
  lastErrorAt  DateTime?
  lastError    String?
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, platform])
  @@index([tenantId])
  @@index([tenantId, platform])
  @@index([locationId])
  @@index([locationId, status])
  @@map("integrations")
}

// ── Menu / Category / Item ────────────────────────────────────────────────────
model Menu {
  id          String     @id @default(cuid())
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      MenuStatus @default(DRAFT)
  isActive    Boolean    @default(true)
  deletedAt   DateTime?

  categories MenuCategory[]
  versions   MenuVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, status])
  @@map("menus")
}

model MenuCategory {
  id          String  @id @default(cuid())
  menuId      String
  menu        Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isVisible   Boolean @default(true)

  items MenuItemOnCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  brandId     String
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  sku         String?
  isAvailable Boolean  @default(true)
  allergens   String[]
  dietaryTags String[] // VEGAN, VEGETARIAN, GLUTEN_FREE, DAIRY_FREE, HALAL, KOSHER
  calories    Int?
  prepTime    Int?     // minutes — overrides location default when set
  metadata    Json     @default("{}")

  // Inventory tracking
  isInventoryTracked Boolean @default(false)
  inventoryCount     Int?

  // Platform-specific pricing overrides — { "UBER_EATS": { "price": 12.99 }, ... }
  platformPricingOverrides Json @default("{}")

  categories         MenuItemOnCategory[]
  modifierGroupLinks ModifierGroupOnItem[]
  variants           MenuItemVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, isAvailable])
  @@map("menu_items")
}

model MenuItemOnCategory {
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemId        String
  item          MenuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sortOrder     Int          @default(0)
  priceOverride Decimal?     @db.Decimal(10, 2)
  isVisible     Boolean      @default(true)

  @@id([categoryId, itemId])
  @@map("menu_items_on_categories")
}

// ── Modifier Groups (normalized, replaces MenuItem.modifierGroups JSON) ───────
model ModifierGroup {
  id            String  @id @default(cuid())
  brandId       String
  brand         Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  minSelections Int     @default(0)
  maxSelections Int?    // null = unlimited
  isRequired    Boolean @default(false)
  sortOrder     Int     @default(0)

  options   ModifierOption[]
  itemLinks ModifierGroupOnItem[]
  // Back-reference for nested modifier groups (this group is nested under an option)
  nestedUnderOptions ModifierOption[] @relation("NestedModifier")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String        @id @default(cuid())
  groupId         String
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  priceAdjustment Decimal       @db.Decimal(10, 2) @default(0)
  imageUrl        String?
  allergens       String[]
  isDefault       Boolean       @default(false)
  isAvailable     Boolean       @default(true)
  sortOrder       Int           @default(0)

  // Nested modifier group — selecting this option reveals a further sub-group
  nestedGroupId String?
  nestedGroup   ModifierGroup? @relation("NestedModifier", fields: [nestedGroupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@map("modifier_options")
}

model ModifierGroupOnItem {
  itemId    String
  item      MenuItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder Int           @default(0)

  @@id([itemId, groupId])
  @@index([itemId])
  @@map("modifier_groups_on_items")
}

// ── MenuItem variants (size / format pricing) ──────────────────────────────────
model MenuItemVariant {
  id          String   @id @default(cuid())
  itemId      String
  item        MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name        String   // "Small", "Regular", "Large"
  sku         String?
  price       Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@map("menu_item_variants")
}

// ── Menu versioning — snapshot on every publish for rollback ──────────────────
model MenuVersion {
  id        String  @id @default(cuid())
  menuId    String
  menu      Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json    // full menu + categories + items denormalized
  label     String?
  createdBy String? // userId who published

  createdAt DateTime @default(now())

  @@unique([menuId, version])
  @@index([menuId])
  @@map("menu_versions")
}

// ── Customer CRM ──────────────────────────────────────────────────────────────
// Customers are not Users — they are end-consumers placing orders.
// A customer may exist without an account (guest checkout), identified by email/phone.
model Customer {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email            String?
  phone            String?
  firstName        String?
  lastName         String?
  marketingConsent Boolean  @default(false)
  isActive         Boolean  @default(true)
  tags             String[] // e.g. ["vip", "regular"]
  metadata         Json     @default("{}")

  addresses CustomerAddress[]
  orders    Order[]
  loyalty   LoyaltyAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, email])
  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?  // "Home", "Work", "Other"
  line1       String
  line2       String?
  city        String
  postcode    String
  country     String   @default("GB")
  isDefault   Boolean  @default(false)
  coordinates Json?    // { lat: number, lng: number }

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_addresses")
}

// Loyalty-ready schema — points/tiers can be implemented on top of this
model LoyaltyAccount {
  id          String   @id @default(cuid())
  customerId  String   @unique
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenantId    String
  points      Int      @default(0)
  tier        String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  totalSpend  Decimal  @db.Decimal(10, 2) @default(0)
  totalOrders Int      @default(0)
  metadata    Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("loyalty_accounts")
}

// ── Promo Codes ───────────────────────────────────────────────────────────────
model PromoCode {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  description   String?
  type          PromoCodeType
  value         Decimal       @db.Decimal(10, 2)
  minOrderValue Decimal?      @db.Decimal(10, 2)
  maxUses       Int?          // null = unlimited
  usedCount     Int           @default(0)
  startAt       DateTime?
  expiresAt     DateTime?
  isActive      Boolean       @default(true)
  locationIds   String[]      // empty = all locations

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("promo_codes")
}

// ── Order ─────────────────────────────────────────────────────────────────────
model Order {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locationId        String
  location          Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // ── Customer link (optional — guest checkout has no customer record) ──────
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ── External platform reference ──────────────────────────
  externalId String?
  platform   OrderPlatform
  displayId  String?

  // ── Channel & integration provenance ─────────────────────
  orderSource       OrderSource       @default(DIRECT)
  integrationSource IntegrationSource @default(DIRECT)
  viaHubrise        Boolean           @default(false)

  // ── Lifecycle ─────────────────────────────────────────────
  status          OrderStatus     @default(PENDING)
  fulfillmentType FulfillmentType @default(DELIVERY)

  // ── Customer data ──────────────────────────────────────────
  customerInfo  Json
  customerName  String?
  customerPhone String?

  // ── Delivery ──────────────────────────────────────────────
  deliveryAddress Json?

  // ── Financials ────────────────────────────────────────────
  subtotal      Decimal @db.Decimal(10, 2)
  taxAmount     Decimal @db.Decimal(10, 2) @default(0)
  serviceCharge Decimal @db.Decimal(10, 2) @default(0)
  deliveryFee   Decimal @db.Decimal(10, 2) @default(0)
  discount      Decimal @db.Decimal(10, 2) @default(0)
  total         Decimal @db.Decimal(10, 2)

  // ── Payment ───────────────────────────────────────────────
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?

  // ── Promo ─────────────────────────────────────────────────
  promoCode     String?  // code applied
  promoDiscount Decimal? @db.Decimal(10, 2)

  // ── Scheduling ────────────────────────────────────────────
  specialInstructions String?
  scheduledFor        DateTime?
  estimatedReadyAt    DateTime?

  // ── Idempotency ───────────────────────────────────────────
  idempotencyKey String? @unique

  // ── Timeline ──────────────────────────────────────────────
  receivedAt       DateTime  @default(now())
  acceptedAt       DateTime?
  preparingAt      DateTime?
  readyAt          DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  // ── Metadata ──────────────────────────────────────────────
  metadata       Json @default("{}")
  sourceMetadata Json @default("{}")

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  kdsTickets       KdsTicket[]
  printJobs        PrintJob[]
  driverAssignment DriverAssignment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalId, platform])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, locationId])
  @@index([tenantId, orderSource])
  @@index([locationId, createdAt(sort: Desc)])
  @@index([locationId, status])
  @@index([locationId, orderSource])
  @@index([platform])
  @@index([orderSource])
  @@index([integrationSource])
  @@index([tenantId, customerPhone])
  @@index([tenantId, customerName])
  @@index([locationId, status, createdAt(sort: Asc)])
  @@index([scheduledFor])
  @@index([customerId])
  @@map("orders")
}

// ── OrderItem ─────────────────────────────────────────────────────────────────
model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  name       String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  modifiers  Json    @default("[]")
  notes      String?
  metadata   Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// ── OrderStatusHistory ────────────────────────────────────────────────────────
model OrderStatusHistory {
  id         String               @id @default(cuid())
  orderId    String
  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId   String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  OrderStatusActorType @default(SYSTEM)
  changedBy  String?
  note       String?
  metadata   Json                 @default("{}")

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([orderId, toStatus])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("order_status_history")
}

// ── WebhookEvent ──────────────────────────────────────────────────────────────
model WebhookEvent {
  id              String    @id @default(cuid())
  platform        String
  externalEventId String
  tenantId        String?
  locationId      String?
  signature       String?
  rawPayload      Json
  processedAt     DateTime?
  processingError String?
  retryCount      Int       @default(0)
  orderId         String?
  metadata        Json      @default("{}")

  receivedAt DateTime @default(now())

  @@unique([platform, externalEventId])
  @@index([platform, receivedAt(sort: Desc)])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([orderId])
  @@map("webhook_events")
}

// ── KDS ───────────────────────────────────────────────────────────────────────
model KdsScreen {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  station    String
  isActive   Boolean  @default(true)
  settings   Json     @default("{}")

  tickets KdsTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([locationId, isActive])
  @@map("kds_screens")
}

model KdsTicket {
  id          String    @id @default(cuid())
  kdsScreenId String
  screen      KdsScreen @relation(fields: [kdsScreenId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bumpedAt    DateTime?
  recalledAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([kdsScreenId, orderId])
  @@index([orderId])
  @@index([kdsScreenId, bumpedAt])
  @@map("kds_tickets")
}

// ── Printer ───────────────────────────────────────────────────────────────────
model Printer {
  id             String                @id @default(cuid())
  tenantId       String
  locationId     String
  location       Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name           String
  type           PrinterType
  connectionType PrinterConnectionType @default(LAN)
  station        PrinterStation        @default(KITCHEN)
  ipAddress      String?
  port           Int?
  isOnline       Boolean               @default(false)
  deletedAt      DateTime?

  // Failover: if this printer fails, route to failoverPrinterId
  failoverPrinterId String?

  supportsReceipts   Boolean @default(true)
  supportsKitchen    Boolean @default(false)
  supportsLabels     Boolean @default(false)
  supportsCut        Boolean @default(true)
  supportsCashDrawer Boolean @default(false)

  // Auto-print rules stored as JSON:
  // [{ "event": "order:new", "types": ["RECEIPT", "KITCHEN_TICKET"] }]
  autoPrintRules Json @default("[]")

  settings  Json @default("{}")
  metadata  Json @default("{}")

  printJobs PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([locationId, station])
  @@index([locationId, type])
  @@index([locationId, isOnline])
  @@map("printers")
}

// ── PrintJob ──────────────────────────────────────────────────────────────────
model PrintJob {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locationId    String
  printerId     String?
  printer       Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type          PrintJobType
  status        PrintJobStatus @default(QUEUED)
  payload       Json
  attempts      Int            @default(0)
  maxRetries    Int            @default(3)
  error         String?
  retryMetadata Json           @default("{}")
  printedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([locationId, status])
  @@index([locationId, createdAt(sort: Desc)])
  @@index([printerId, status])
  @@index([orderId])
  @@map("print_jobs")
}

// ── Print Templates ───────────────────────────────────────────────────────────
// Custom receipt / kitchen ticket / label templates per tenant or location
model PrintTemplate {
  id         String       @id @default(cuid())
  tenantId   String
  locationId String?      // null = applies to all locations in tenant
  name       String
  type       PrintJobType
  template   Json         // template slots and layout config
  isDefault  Boolean      @default(false)
  isActive   Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("print_templates")
}

// ── Driver / Dispatch Foundation ──────────────────────────────────────────────
model Driver {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String? // link to User if driver has a dashboard login
  firstName   String
  lastName    String
  phone       String
  email       String?
  isActive    Boolean @default(true)
  vehicleType String? // BIKE, SCOOTER, CAR, FOOT
  metadata    Json    @default("{}")

  assignments DriverAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("drivers")
}

model DriverAssignment {
  id          String                 @id @default(cuid())
  orderId     String                 @unique
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId    String
  driver      Driver                 @relation(fields: [driverId], references: [id], onDelete: Restrict)
  status      DriverAssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime               @default(now())
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  tracking DeliveryTracking[]

  @@index([driverId])
  @@index([driverId, status])
  @@map("driver_assignments")
}

// Append-only GPS breadcrumb trail for delivery tracking
model DeliveryTracking {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   DriverAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  accuracy     Float?
  heading      Float?
  speed        Float?
  event        String?          // "PICKUP", "DELIVERY", "WAYPOINT"

  recordedAt DateTime @default(now())

  @@index([assignmentId, recordedAt(sort: Desc)])
  @@map("delivery_tracking")
}

