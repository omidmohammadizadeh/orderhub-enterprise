// ─────────────────────────────────────────────────────────────────────────────
// OrderHub Enterprise — Prisma Schema v2
// Multi-tenant omnichannel restaurant integration platform
//
// Design principles:
//  1. tenantId is ALWAYS denormalised on write-heavy tables to avoid JOINs
//     at query time. The application enforces tenant isolation at the service
//     layer; RLS can be added at the Postgres level in a future phase.
//  2. Soft-delete (deletedAt) is used only for configuration entities that
//     operators manage (brands, locations, menus, printers, integrations).
//     Transactional records (orders, webhooks, print jobs, audit logs) are
//     NEVER soft-deleted — they are archived or retained per policy instead.
//  3. Cascade rules are explicit on every FK:
//       - Cascade: child record has no independent identity (e.g. OrderItem)
//       - Restrict: FK prevents accidental parent deletion (e.g. Order→Tenant)
//       - SetNull: FK becomes nullable when parent removed (e.g. PrintJob→Printer)
//  4. All timeline/audit columns are written ONCE; updatedAt is omitted from
//     immutable records (OrderStatusHistory, AuditLog, WebhookEvent, OrderItem)
//     to make immutability explicit rather than implicit.
//  5. customerPhone and customerName are extracted from customerInfo JSON to
//     support indexed searches without computed columns or GIN indexes.
//  6. Partitioning preparation: orders are keyed (tenantId, createdAt) and all
//     composite indexes lead with tenantId or locationId to match future
//     Postgres RANGE partitioning by created_at within tenant shards.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["fullTextSearch", "metrics"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ── Tenant (Organisation) ─────────────────────────────────────────────────────
model Tenant {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  plan     TenantPlan   @default(STARTER)
  status   TenantStatus @default(ACTIVE)
  settings Json         @default("{}")
  metadata Json         @default("{}")

  brands    Brand[]
  users     User[]
  apiKeys   ApiKey[]
  orders    Order[]
  printJobs PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

// ── User ──────────────────────────────────────────────────────────────────────
model User {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String    @unique
  password    String?
  firstName   String
  lastName    String
  avatarUrl   String?
  role        UserRole  @default(VIEWER)
  permissions String[]  @default([])
  isActive    Boolean   @default(true)
  isVerified  Boolean   @default(false)
  lastLoginAt DateTime?

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, isActive])
  @@map("users")
}

// ── RefreshToken ──────────────────────────────────────────────────────────────
// Immutable once created — only revokedAt changes. updatedAt intentionally omitted.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── OAuthAccount ──────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?
  rawProfile        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ── ApiKey ────────────────────────────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("api_keys")
}

// ── AuditLog ──────────────────────────────────────────────────────────────────
// Immutable append-only record. userId is nullable so system events (no actor)
// and post-user-deletion events are still recorded. updatedAt intentionally omitted.
// tenantId is a raw column — no FK relation because audit logs must survive
// tenant deletion (legal/compliance requirement).
model AuditLog {
  id         String  @id @default(cuid())
  tenantId   String
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  event      String
  resource   String?
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  meta       Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
  @@index([userId])
  @@index([event])
  @@map("audit_logs")
}

// ── Brand ─────────────────────────────────────────────────────────────────────
// Soft-delete: set deletedAt instead of removing. Preserves referential
// integrity with historical orders.
model Brand {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  logoUrl   String?
  settings  Json      @default("{}")
  metadata  Json      @default("{}")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  locations Location[]
  menus     Menu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("brands")
}

// ── Location ──────────────────────────────────────────────────────────────────
// Soft-delete. A location may have thousands of historical orders; hard deletion
// would orphan them or force a cascade that destroys operational history.
model Location {
  id          String    @id @default(cuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  externalRef String?
  address     Json
  phone       String?
  timezone    String    @default("Europe/London")
  isActive    Boolean   @default(true)
  settings    Json      @default("{}")
  metadata    Json      @default("{}")
  deletedAt   DateTime?

  integrations Integration[]
  orders       Order[]
  printers     Printer[]
  kdsScreens   KdsScreen[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, deletedAt])
  @@map("locations")
}

// ── Integration ───────────────────────────────────────────────────────────────
// Soft-delete. Credentials and settings must be preserved after deactivation
// for audit purposes. tenantId denormalised to avoid Brand→Location JOIN.
model Integration {
  id           String              @id @default(cuid())
  tenantId     String
  locationId   String
  location     Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  platform     IntegrationPlatform
  status       IntegrationStatus   @default(INACTIVE)
  credentials  Json
  settings     Json                @default("{}")
  webhookUrl   String?
  syncMetadata Json                @default("{}")
  lastSyncAt   DateTime?
  lastErrorAt  DateTime?
  lastError    String?
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, platform])
  @@index([tenantId])
  @@index([tenantId, platform])
  @@index([locationId])
  @@index([locationId, status])
  @@map("integrations")
}

// ── Menu / Category / Item ────────────────────────────────────────────────────
// Menus are soft-deleted to preserve historical display names on past orders.
model Menu {
  id        String    @id @default(cuid())
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  categories MenuCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@map("menus")
}

model MenuCategory {
  id        String @id @default(cuid())
  menuId    String
  menu      Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  items MenuItemOnCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
  @@map("menu_categories")
}

model MenuItem {
  id             String   @id @default(cuid())
  brandId        String
  name           String
  description    String?
  basePrice      Decimal  @db.Decimal(10, 2)
  imageUrl       String?
  sku            String?
  isAvailable    Boolean  @default(true)
  modifierGroups Json     @default("[]")
  allergens      String[]
  calories       Int?
  metadata       Json     @default("{}")

  categories MenuItemOnCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([brandId, isAvailable])
  @@map("menu_items")
}

model MenuItemOnCategory {
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemId        String
  item          MenuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sortOrder     Int          @default(0)
  priceOverride Decimal?     @db.Decimal(10, 2)

  @@id([categoryId, itemId])
  @@map("menu_items_on_categories")
}

// ── Order ─────────────────────────────────────────────────────────────────────
// The canonical order record. All platforms normalise into this single model.
//
// Cascade / FK policy:
//   Order → Tenant: RESTRICT — a tenant with orders cannot be deleted
//   Order → Location: RESTRICT — a location with orders cannot be deleted
//   (deletion of these entities must go through soft-delete + archival)
//
// Customer search columns:
//   customerName and customerPhone are extracted from customerInfo JSON at
//   write time to support B-tree indexed searches without GIN overhead.
//   customerInfo JSON is the authoritative source; these are search projections.
//
// Partitioning readiness:
//   The primary composite query patterns (tenantId + createdAt, locationId + status)
//   are the intended future partition keys for Postgres RANGE partitioning.
//   When volume exceeds ~50M rows, partition by RANGE(created_at) within
//   tenant shards. All indexes lead with tenant/location to remain valid
//   after partitioning.
//
// Analytics readiness:
//   sourceMetadata stores the raw platform context (original displayId, courier
//   assignment, scheduling info) without polluting the normalized columns.
//   This JSON blob is intended to be streamed to ClickHouse or BigQuery.
model Order {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // ── External platform reference ──────────────────────────
  externalId String?
  platform   OrderPlatform
  displayId  String?

  // ── Channel & integration provenance ─────────────────────
  // orderSource = "who sent this order" (the sales channel)
  // integrationSource = "how did it arrive" (the adapter)
  // viaHubrise = audit flag for compliance reporting
  orderSource       OrderSource       @default(DIRECT)
  integrationSource IntegrationSource @default(DIRECT)
  viaHubrise        Boolean           @default(false)

  // ── Lifecycle ─────────────────────────────────────────────
  status          OrderStatus     @default(PENDING)
  fulfillmentType FulfillmentType @default(DELIVERY)

  // ── Customer (full record + extracted search columns) ─────
  customerInfo  Json
  customerName  String? // extracted from customerInfo.name at write time
  customerPhone String? // extracted from customerInfo.phone at write time

  // ── Delivery ──────────────────────────────────────────────
  deliveryAddress Json?

  // ── Financials (Decimal for accounting precision) ─────────
  subtotal    Decimal @db.Decimal(10, 2)
  taxAmount   Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  // ── Payment ───────────────────────────────────────────────
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?

  // ── Scheduling ────────────────────────────────────────────
  specialInstructions String?
  scheduledFor        DateTime?
  estimatedReadyAt    DateTime?

  // ── Idempotency ───────────────────────────────────────────
  idempotencyKey String? @unique

  // ── Timeline (each written exactly once, never updated) ───
  receivedAt       DateTime  @default(now())
  acceptedAt       DateTime?
  preparingAt      DateTime?
  readyAt          DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  // ── Metadata ──────────────────────────────────────────────
  metadata       Json @default("{}")
  sourceMetadata Json @default("{}") // raw platform payload context

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  kdsTickets    KdsTicket[]
  printJobs     PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotency: NULL externalId rows do NOT conflict (PG treats NULLs as distinct)
  @@unique([externalId, platform])
  // ── Tenant-scoped indexes (primary query pattern) ─────────
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, locationId])
  @@index([tenantId, orderSource])
  // ── Location-scoped indexes (dashboard query pattern) ─────
  @@index([locationId, createdAt(sort: Desc)])
  @@index([locationId, status])
  @@index([locationId, orderSource])
  // ── Platform / source indexes ─────────────────────────────
  @@index([platform])
  @@index([orderSource])
  @@index([integrationSource])
  // ── Customer search indexes ───────────────────────────────
  @@index([tenantId, customerPhone])
  @@index([tenantId, customerName])
  // ── Operational / live board ──────────────────────────────
  @@index([locationId, status, createdAt(sort: Asc)]) // live board ordering
  @@index([scheduledFor])
  @@map("orders")
}

// ── OrderItem ─────────────────────────────────────────────────────────────────
// Immutable after creation. updatedAt intentionally omitted.
// Modifiers are stored as a JSON array — no separate table needed unless
// modifier-level analytics are required (future phase).
model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String? // nullable: platform items may not map to a local menu item
  name       String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  modifiers  Json    @default("[]")
  notes      String?
  metadata   Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// ── OrderStatusHistory ────────────────────────────────────────────────────────
// Immutable append-only audit trail. updatedAt intentionally omitted.
// actorType identifies who triggered the transition for compliance reporting.
// tenantId denormalised so this table can be queried without joining orders.
model OrderStatusHistory {
  id         String               @id @default(cuid())
  orderId    String
  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId   String // denormalised for audit queries without JOIN
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  OrderStatusActorType @default(SYSTEM)
  changedBy  String? // userId, "system", "webhook:{platform}", "api-key:{prefix}"
  note       String?
  metadata   Json                 @default("{}")

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([orderId, toStatus])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("order_status_history")
}

// ── WebhookEvent ──────────────────────────────────────────────────────────────
// Idempotency log and raw payload archive for all inbound webhook deliveries.
// Immutable once created. processedAt and processingError are written at most
// once per record after initial insert. updatedAt intentionally omitted.
// tenantId / locationId are nullable — populated during processing, not on receipt.
model WebhookEvent {
  id              String    @id @default(cuid())
  platform        String
  externalEventId String
  tenantId        String? // populated after integration lookup
  locationId      String? // populated after integration lookup
  signature       String?
  rawPayload      Json
  processedAt     DateTime?
  processingError String?
  retryCount      Int       @default(0)
  orderId         String?
  metadata        Json      @default("{}")

  receivedAt DateTime @default(now())

  @@unique([platform, externalEventId])
  @@index([platform, receivedAt(sort: Desc)])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([orderId])
  @@map("webhook_events")
}

// ── KDS ───────────────────────────────────────────────────────────────────────
model KdsScreen {
  id         String   @id @default(cuid())
  tenantId   String // denormalised for fast tenant-scoped queries
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  station    String
  isActive   Boolean  @default(true)
  settings   Json     @default("{}")

  tickets KdsTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([locationId, isActive])
  @@map("kds_screens")
}

// KdsTicket: immutable display assignment. bumpedAt and recalledAt are the
// lifecycle markers; updatedAt omitted since we don't need last-write tracking.
model KdsTicket {
  id          String    @id @default(cuid())
  kdsScreenId String
  screen      KdsScreen @relation(fields: [kdsScreenId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bumpedAt    DateTime?
  recalledAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([kdsScreenId, orderId])
  @@index([orderId])
  @@index([kdsScreenId, bumpedAt])
  @@map("kds_tickets")
}

// ── Printer ───────────────────────────────────────────────────────────────────
// Soft-delete. Printers accumulate historical print jobs; hard deletion would
// set PrintJob.printerId to NULL via SetNull, losing hardware routing history.
model Printer {
  id             String                @id @default(cuid())
  tenantId       String // denormalised for fast tenant-scoped queries
  locationId     String
  location       Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name           String
  type           PrinterType
  connectionType PrinterConnectionType @default(LAN)
  station        PrinterStation        @default(KITCHEN)
  ipAddress      String?
  port           Int?
  isOnline       Boolean               @default(false)
  deletedAt      DateTime?

  // Capability flags — used to route jobs without querying hardware state
  supportsReceipts   Boolean @default(true)
  supportsKitchen    Boolean @default(false)
  supportsLabels     Boolean @default(false)
  supportsCut        Boolean @default(true)
  supportsCashDrawer Boolean @default(false)

  settings Json @default("{}")
  metadata Json @default("{}") // hardware-specific config (baud rate, model, etc.)

  printJobs PrintJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([locationId, station])
  @@index([locationId, type])
  @@index([locationId, isOnline])
  @@map("printers")
}

// ── PrintJob ──────────────────────────────────────────────────────────────────
// Immutable intent record + mutable status. The payload JSON contains a
// fully-rendered print document — enough to re-dispatch without reading Order.
// retryMetadata records attempt history for operational debugging.
model PrintJob {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locationId    String
  printerId     String?
  printer       Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type          PrintJobType
  status        PrintJobStatus @default(QUEUED)
  payload       Json // fully self-contained print document
  attempts      Int            @default(0)
  maxRetries    Int            @default(3)
  error         String?
  retryMetadata Json           @default("{}") // per-attempt error log
  printedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([locationId, status])
  @@index([locationId, createdAt(sort: Desc)])
  @@index([printerId, status])
  @@index([orderId])
  @@map("print_jobs")
}

// ══════════════════════════════════════════════════════════════════════════════
// Enums
// ══════════════════════════════════════════════════════════════════════════════

enum TenantPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_OWNER
  MANAGER
  CASHIER
  KITCHEN_STAFF
  DRIVER
  VIEWER
}

enum OAuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
  UBER_EATS
  DELIVEROO
  JUST_EAT
}

enum IntegrationPlatform {
  UBER_EATS
  DELIVEROO
  JUST_EAT
  HUBRISE
  DIRECT
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING_SETUP
}

enum OrderPlatform {
  UBER_EATS
  DELIVEROO
  JUST_EAT
  HUBRISE
  DIRECT
  POS
  ONLINE
}

// The sales channel that originated the order
enum OrderSource {
  ONLINE // Customer ordered via our direct ordering URL
  POS // Order created at the point-of-sale terminal
  UBER_EATS // Order came from Uber Eats marketplace
  DELIVEROO // Order came from Deliveroo marketplace
  JUST_EAT // Order came from Just Eat marketplace
  HUBRISE // Order was routed via HubRise middleware
  DIRECT // Internal/manual order (default)
}

// Which integration adapter delivered the order into our system
enum IntegrationSource {
  DIRECT // Our own webhook / API / online ordering
  HUBRISE // HubRise routed it (may proxy Uber Eats, Deliveroo, etc.)
}

enum FulfillmentType {
  PICKUP // Customer collects in person
  DELIVERY // Generic delivery (courier TBD at dispatch)
  DINE_IN // Table service — customer eats in
  MERCHANT_DELIVERY // Restaurant owns the delivery operation
  PLATFORM_COURIER // Platform arranges courier (Uber driver, Deliveroo rider)
}

enum OrderStatus {
  PENDING // Received, awaiting acceptance
  ACCEPTED // Restaurant confirmed the order
  PREPARING // Kitchen is actively working on it
  READY // Complete, waiting for collection / courier handoff
  DISPATCHED // With a courier / en route
  COMPLETED // Successfully delivered or collected
  CANCELLED // Cancelled by restaurant, platform, or customer
  REJECTED // Restaurant explicitly refused the order
}

// Who or what triggered a status transition — essential for audit trails
// and for distinguishing between staff actions and automated platform syncs.
enum OrderStatusActorType {
  STAFF // Human staff member via dashboard or POS
  SYSTEM // Automatic transition by platform logic or scheduler
  WEBHOOK // Inbound status update from a delivery platform
  API // API key holder (third-party integration)
  KIOSK // Self-service kiosk
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum PrinterType {
  RECEIPT
  KITCHEN
  LABEL
  MULTI
}

enum PrinterConnectionType {
  USB
  LAN // TCP/IP thermal printer (most common)
  BLUETOOTH
  EPSON_EPOS // Epson ePOS SDK over HTTP
  STAR // Star Micronics CloudPRNT
  CLOUD // Cloud relay service
}

enum PrinterStation {
  KITCHEN
  FRONT_COUNTER
  BAR
  LABELS
  DISPATCH
}

enum PrintJobType {
  RECEIPT // Customer receipt (with totals, payment)
  KITCHEN_TICKET // Kitchen order ticket (items only, no prices)
  LABEL // Item / packaging label
  DRIVER_RECEIPT // Driver pickup slip
  CANCEL_TICKET // Cancellation notice for kitchen
  REPRINT // Manual reprint of a previous job
  EOD_REPORT // End-of-day summary report
}

enum PrintJobStatus {
  QUEUED // Waiting for processing
  PRINTING // Sent to hardware, awaiting confirmation
  PRINTED // Hardware confirmed receipt
  FAILED // All retries exhausted
  RETRYING // Waiting for next retry attempt
}
