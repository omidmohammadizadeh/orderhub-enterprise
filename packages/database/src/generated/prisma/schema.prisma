// ─────────────────────────────────────────────────────────
// OrderHub Enterprise — Prisma Schema
// Multi-tenant restaurant integration platform
// ─────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearch", "metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenant (Organisation) ─────────────────────────────────
model Tenant {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  plan     TenantPlan   @default(STARTER)
  status   TenantStatus @default(ACTIVE)
  settings Json         @default("{}")

  brands  Brand[]
  users   User[]
  apiKeys ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

// ── User ──────────────────────────────────────────────────
// A user belongs to exactly one tenant. PLATFORM_ADMIN users have a
// special synthetic tenantId ("__platform__") that bypasses tenant isolation.
model User {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String    @unique
  password    String? // Nullable — OAuth-only users have no password
  firstName   String
  lastName    String
  avatarUrl   String?
  role        UserRole  @default(VIEWER)
  // Fine-grained overrides on top of the role hierarchy.
  // Format: ["orders:write", "menus:read", ...] — see permissions.constants.ts
  permissions String[]  @default([])
  isActive    Boolean   @default(true)
  isVerified  Boolean   @default(false)
  lastLoginAt DateTime?

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ── RefreshToken ──────────────────────────────────────────
// Stores a SHA-256 hash of the opaque random token sent to the client.
// Never store the raw token — if this table is compromised, hashes are useless
// without the originals (high-entropy random bytes resist brute force).
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique // SHA-256(raw_token)
  expiresAt         DateTime
  revokedAt         DateTime?
  // Token theft detection: if a revoked token is replayed, we flag this.
  // The handler will then revoke ALL tokens for this user.
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ── OAuthAccount ──────────────────────────────────────────
// Separates identity from the user record. One user can link multiple
// OAuth providers (Google, Apple, Microsoft, plus marketplace OAuth for
// Uber Eats / Deliveroo / Just Eat merchant connections).
// This design means changing or adding a provider never touches the User table.
model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String // The user's stable ID on the provider
  // All tokens are encrypted at the application layer before storage.
  // Use the EncryptionService — never store these in plaintext.
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  // OIDC providers include an id_token (JWT) with profile claims
  idToken           String?
  rawProfile        Json? // Cached provider profile for debugging

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ── ApiKey ────────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String // e.g. "oh_live_" — shown in UI
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("api_keys")
}

// ── AuditLog ──────────────────────────────────────────────
// Append-only. Never update or delete rows.
// auth.* events are written by the AuthService on every auth action.
model AuditLog {
  id         String  @id @default(cuid())
  tenantId   String
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Dot-notation event type: "auth.login.success", "order.status.changed"
  event      String
  resource   String?
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  meta       Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([event])
  @@map("audit_logs")
}

// ── Brand ─────────────────────────────────────────────────
model Brand {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  logoUrl  String?
  settings Json    @default("{}")
  isActive Boolean @default(true)

  locations Location[]
  menus     Menu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("brands")
}

// ── Location ──────────────────────────────────────────────
model Location {
  id          String  @id @default(cuid())
  brandId     String
  brand       Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  externalRef String?
  address     Json
  phone       String?
  timezone    String  @default("Europe/London")
  isActive    Boolean @default(true)
  settings    Json    @default("{}")

  integrations Integration[]
  orders       Order[]
  printers     Printer[]
  kdsScreens   KdsScreen[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@map("locations")
}

// ── Integration ───────────────────────────────────────────
model Integration {
  id          String              @id @default(cuid())
  locationId  String
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  platform    IntegrationPlatform
  status      IntegrationStatus   @default(INACTIVE)
  credentials Json
  settings    Json                @default("{}")
  webhookUrl  String?
  lastSyncAt  DateTime?
  lastErrorAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, platform])
  @@index([locationId])
  @@map("integrations")
}

// ── Menu / Category / Item ────────────────────────────────
model Menu {
  id       String  @id @default(cuid())
  brandId  String
  brand    Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name     String
  isActive Boolean @default(true)

  categories MenuCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@map("menus")
}

model MenuCategory {
  id        String @id @default(cuid())
  menuId    String
  menu      Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  items MenuItemOnCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
  @@map("menu_categories")
}

model MenuItem {
  id             String   @id @default(cuid())
  brandId        String
  name           String
  description    String?
  basePrice      Decimal  @db.Decimal(10, 2)
  imageUrl       String?
  sku            String?
  isAvailable    Boolean  @default(true)
  modifierGroups Json     @default("[]")
  allergens      String[]
  calories       Int?
  metadata       Json     @default("{}")

  categories MenuItemOnCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@map("menu_items")
}

model MenuItemOnCategory {
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemId        String
  item          MenuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sortOrder     Int          @default(0)
  priceOverride Decimal?     @db.Decimal(10, 2)

  @@id([categoryId, itemId])
  @@map("menu_items_on_categories")
}

// ── Order ─────────────────────────────────────────────────
model Order {
  id                  String        @id @default(cuid())
  locationId          String
  location            Location      @relation(fields: [locationId], references: [id])
  externalId          String?
  platform            OrderPlatform
  displayId           String?
  status              OrderStatus   @default(PENDING)
  type                OrderType     @default(DELIVERY)
  customerInfo        Json
  deliveryAddress     Json?
  items               OrderItem[]
  subtotal            Decimal       @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0) @db.Decimal(10, 2)
  deliveryFee         Decimal       @default(0) @db.Decimal(10, 2)
  discount            Decimal       @default(0) @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       String?
  specialInstructions String?
  scheduledFor        DateTime?
  estimatedReadyAt    DateTime?
  acceptedAt          DateTime?
  prepStartedAt       DateTime?
  readyAt             DateTime?
  dispatchedAt        DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  metadata            Json          @default("{}")

  statusHistory OrderStatusHistory[]
  kdsTickets    KdsTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalId, platform])
  @@index([locationId, status])
  @@index([locationId, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  name       String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  modifiers  Json    @default("[]")
  notes      String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?
  note       String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// ── KDS ───────────────────────────────────────────────────
model KdsScreen {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  station    String
  isActive   Boolean  @default(true)
  settings   Json     @default("{}")

  tickets KdsTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@map("kds_screens")
}

model KdsTicket {
  id          String    @id @default(cuid())
  kdsScreenId String
  screen      KdsScreen @relation(fields: [kdsScreenId], references: [id])
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  bumpedAt    DateTime?
  recalledAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([kdsScreenId, orderId])
  @@map("kds_tickets")
}

// ── Printer ───────────────────────────────────────────────
model Printer {
  id         String      @id @default(cuid())
  locationId String
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  type       PrinterType
  ipAddress  String?
  port       Int?
  isOnline   Boolean     @default(false)
  settings   Json        @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@map("printers")
}

// ══════════════════════════════════════════════════════════
// Enums
// ══════════════════════════════════════════════════════════

enum TenantPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// Role hierarchy (highest → lowest):
// PLATFORM_ADMIN > TENANT_OWNER > MANAGER > CASHIER / KITCHEN_STAFF / DRIVER > VIEWER
enum UserRole {
  PLATFORM_ADMIN // Cross-tenant — OrderHub staff only
  TENANT_OWNER // Full access within their tenant
  MANAGER // All ops, no billing
  CASHIER // Orders + payments, no settings
  KITCHEN_STAFF // KDS + order status updates only
  DRIVER // Dispatch view only
  VIEWER // Read-only across the tenant
}

enum OAuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
  // Marketplace OAuth — used for connecting merchant accounts,
  // not for staff login. Same OAuthAccount model, different semantics.
  UBER_EATS
  DELIVEROO
  JUST_EAT
}

enum IntegrationPlatform {
  UBER_EATS
  DELIVEROO
  JUST_EAT
  DIRECT
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING_SETUP
}

enum OrderPlatform {
  UBER_EATS
  DELIVEROO
  JUST_EAT
  DIRECT
}

enum OrderType {
  DELIVERY
  COLLECTION
  DINE_IN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum PrinterType {
  RECEIPT
  KITCHEN
  LABEL
}
