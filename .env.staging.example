# ─────────────────────────────────────────────────────────
# OrderHub — Staging Environment
# Copy to .env.staging and fill in real values.
# NEVER commit .env.staging — it contains real credentials.
# ─────────────────────────────────────────────────────────

NODE_ENV=staging
PORT=4000
APP_URL=https://staging.orderhub.io
API_URL=https://api-staging.orderhub.io

# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://orderhub:CHANGE_ME@staging-db.internal:5432/orderhub_staging"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────
REDIS_URL="redis://:CHANGE_ME@staging-redis.internal:6379"
QUEUE_REDIS_URL="redis://:CHANGE_ME@staging-redis.internal:6379"

# ── Auth / JWT ───────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_STRONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Encryption ───────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_TO_64_HEX_CHARS

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Platform Webhooks ────────────────────────────────────
# Staging platforms use test/sandbox credentials
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_WEBHOOK_SECRET=

DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=

JUST_EAT_API_KEY=
JUST_EAT_WEBHOOK_SECRET=

HUBRISE_APP_ID=
HUBRISE_APP_SECRET=

# ── Email ────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="OrderHub Staging <noreply@staging.orderhub.io>"

# ── Socket.IO ────────────────────────────────────────────
SOCKET_CORS_ORIGIN=https://staging.orderhub.io

# ── Observability ────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=https://...@sentry.io/... # staging project DSN
OTEL_SERVICE_NAME=orderhub-api-staging

# ── Feature Flags ────────────────────────────────────────
ENABLE_ANALYTICS=true
ENABLE_DISPATCH=true
ENABLE_KDS=true
ENABLE_MAINTENANCE_MODE=false

# ── Rate Limiting ────────────────────────────────────────
THROTTLE_WEBHOOK_LIMIT=300
THROTTLE_LOGIN_LIMIT=10
