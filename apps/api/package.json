{
  "name": "@orderhub/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf dist node_modules/.cache/.tsbuildinfo && nest start --watch",
    "build": "rm -rf dist node_modules/.cache/.tsbuildinfo && nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "clean": "rm -rf dist",
    "db:migrate": "prisma migrate deploy --schema=../../packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "db:backfill-encryption": "ts-node -P tsconfig.json src/scripts/backfill-credential-encryption.ts",
    "db:rotate-keys": "ts-node -P tsconfig.json src/scripts/rotate-credential-encryption.ts",
    "deploy:preflight": "pnpm db:generate && pnpm type-check && pnpm test -- --no-coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@nestjs/bull": "^10.2.1",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/platform-socket.io": "^10.4.7",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.7",
    "@orderhub/database": "workspace:*",
    "@orderhub/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.108.2",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.4",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "cron": "^3.1.7",
    "date-fns": "^4.1.0",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "nest-winston": "^1.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "stripe": "^17.4.0",
    "uuid": "^11.0.3",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.7",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.7",
    "@orderhub/eslint-config": "workspace:*",
    "@orderhub/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^4.10.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
