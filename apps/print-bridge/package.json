{
  "name": "@orderhub/print-bridge",
  "version": "0.1.0",
  "description": "Order Hub cross-platform print bridge — claims and executes PrintJobs on the local device.",
  "main": "dist/main.js",
  "bin": {
    "orderhub-print-bridge": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev src/main.ts",
    "package:mac": "pkg . --targets node18-macos-x64,node18-macos-arm64 --output ../../dist/print-bridge/orderhub-print-bridge-mac",
    "package:win": "pkg . --targets node18-win-x64 --output ../../dist/print-bridge/orderhub-print-bridge-win.exe",
    "package:linux": "pkg . --targets node18-linux-x64 --output ../../dist/print-bridge/orderhub-print-bridge-linux"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": ["dist/**/*.json"]
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "jimp": "^0.22.12",
    "socket.io-client": "^4.7.5",
    "ws": "^8.18.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "pkg": "^5.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "optionalDependencies": {
    "@abandonware/noble": "^1.9.2-25",
    "usb": "^2.13.0"
  }
}
