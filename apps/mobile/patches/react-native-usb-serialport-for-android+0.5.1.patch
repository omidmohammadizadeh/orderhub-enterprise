+    /**
+     * Default probe table PLUS the vendor-specific FTDI product IDs we ship
+     * hardware for.
+     *
+     * FTDI (vendor 0x0403) lets a manufacturer burn a custom product ID into
+     * the chip's EEPROM. The CT Comet caller-ID box does exactly that — it is
+     * an ordinary FTDI part reporting 0x8e08 — and usb-serial-for-android
+     * probes by a hard-coded PID list, so getDefaultProber() returns null for
+     * a chip it knows perfectly well how to drive. The device enumerates,
+     * Android names it, permission is granted, and every open fails with
+     * "no driver for device" at every baud rate.
+     */
+    private static final UsbSerialProber ORDERHUB_PROBER = buildProber();
+
+    private static UsbSerialProber buildProber() {
+        ProbeTable table = UsbSerialProber.getDefaultProbeTable();
+        // CT Comet USB caller-ID unit — FTDI silicon, custom PID.
+        table.addProduct(0x0403, 0x8e08, FtdiSerialDriver.class);
+        return new UsbSerialProber(table);
+    }
