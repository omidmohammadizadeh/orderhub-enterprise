# Expo + pnpm monorepos — use hoisted node_modules instead of pnpm's
# default symlinked layout. React Native's Gradle autolinking script
# walks node_modules/react-native/sdks/... directly and doesn't follow
# pnpm symlinks, which causes EAS Android builds to fail with:
#   Error resolving plugin [id: 'com.facebook.react.settings']
#   > Included build '.../apps/mobile/android/null' does not exist.
#
# Hoisted mode mirrors what npm/yarn classic does — flatter, slightly
# more disk space, but compatible with every native-module bundler.
# This file applies ONLY to the apps/mobile workspace; the rest of the
# monorepo keeps using pnpm's default linker.
node-linker=hoisted
