{
  "expo": {
    "name": "Eat For Less",
    "slug": "eat-for-less",
    "scheme": "eatforless",
    "version": "0.1.12",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eatforless.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Eat For Less uses your location to find shops near you and to deliver your order.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.eatforless.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0B"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0B0B0B",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eat For Less uses your location to find shops near you and to deliver your order."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.eatforless.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#0B0B0B",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://orderhub-api-0re6.onrender.com/api",
      "eas": {
        "projectId": "e0520a8a-ca63-444f-b91e-2b3288fca4e2"
      }
    },
    "owner": "maclondas"
  }
}
