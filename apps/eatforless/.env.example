# Copy to .env for local runs. Everything here is optional.

# API base, without a trailing slash. Defaults to the live OrderHub API.
EXPO_PUBLIC_EFL_API_URL=https://orderhub-api-0re6.onrender.com/api

# DEV ONLY: 1 = run every screen on built-in sample data (no network, no
# payments). Use it while no shops are listed yet. Never set in a store build.
EXPO_PUBLIC_EFL_MOCK=0

# DEV FALLBACK ONLY: the app reads the Stripe publishable key from
# GET /v1/efl/config. This is used only in dev builds when that has no key.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# EAS project id (after `eas init`). Without it push tokens can't be minted.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Google Sign-In OAuth clients (Eat For Less Ltd's Google Cloud project).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Maps SDK keys for the live-tracking map (restricted to com.eatforless.app).
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=
