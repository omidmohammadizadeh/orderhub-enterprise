{
  "name": "@orderhub/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf dist node_modules/.cache/.tsbuildinfo && nest start --watch",
    "build": "rm -rf dist node_modules/.cache/.tsbuildinfo && nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orderhub/database": "workspace:*",
    "@orderhub/shared": "workspace:*",
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/bull": "^10.2.1",
    "@nestjs/config": "^3.3.0",
    "@nestjs/websockets": "^10.4.7",
    "@nestjs/platform-socket.io": "^10.4.7",
    "bull": "^4.16.4",
    "ioredis": "^5.4.1",
    "socket.io-client": "^4.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "axios": "^1.7.9",
    "winston": "^3.17.0",
    "nest-winston": "^1.10.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@orderhub/eslint-config": "workspace:*",
    "@orderhub/tsconfig": "workspace:*",
    "@nestjs/cli": "^10.4.7",
    "@nestjs/testing": "^10.4.7",
    "@types/node": "^22.10.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
