# ─────────────────────────────────────────────────────────
# OrderHub — Production Environment
# Copy to .env.production and fill in real values.
# NEVER commit .env.production — it contains live secrets.
#
# On cloud deployments, prefer injecting these as secrets
# via your provider (ECS task definitions, K8s secrets,
# Fly.io secrets) rather than writing to a file.
# ─────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
APP_URL=https://app.orderhub.io
API_URL=https://api.orderhub.io

# ── Database ─────────────────────────────────────────────
# Use a connection pooler (e.g. PgBouncer, RDS Proxy) in production
DATABASE_URL="postgresql://orderhub:CHANGE_ME@prod-db.internal:5432/orderhub_prod?sslmode=require"
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────
# Use Redis Cluster or ElastiCache in production
REDIS_URL="redis://:CHANGE_ME@prod-redis.internal:6379"
REDIS_PASSWORD=CHANGE_ME
QUEUE_REDIS_URL="redis://:CHANGE_ME@prod-redis.internal:6379"

# ── Auth / JWT ───────────────────────────────────────────
# Generate: openssl rand -hex 32
# CRITICAL: These must never match any non-production values
JWT_SECRET=CHANGE_ME_PRODUCTION_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_PRODUCTION_REFRESH_SECRET_AT_LEAST_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Encryption ───────────────────────────────────────────
# Generate: openssl rand -hex 32
# CRITICAL: Changing this will invalidate all stored integration credentials
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Platform Webhooks ────────────────────────────────────
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_WEBHOOK_SECRET=

DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=

JUST_EAT_API_KEY=
JUST_EAT_WEBHOOK_SECRET=

HUBRISE_APP_ID=
HUBRISE_APP_SECRET=

# ── Email ────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="OrderHub <noreply@orderhub.io>"

# ── Socket.IO ────────────────────────────────────────────
SOCKET_CORS_ORIGIN=https://app.orderhub.io
SOCKET_MAX_CONNECTIONS_PER_LOCATION=200

# ── Observability ────────────────────────────────────────
LOG_LEVEL=warn
SENTRY_DSN=https://...@sentry.io/... # production project DSN
DATADOG_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.datadoghq.com/api/intake/otlp/v1/traces
OTEL_SERVICE_NAME=orderhub-api

# ── Feature Flags ────────────────────────────────────────
ENABLE_ANALYTICS=true
ENABLE_DISPATCH=true
ENABLE_KDS=true
ENABLE_MAINTENANCE_MODE=false

# ── Rate Limiting ────────────────────────────────────────
THROTTLE_WEBHOOK_LIMIT=300
THROTTLE_LOGIN_LIMIT=5

# ── Docker Compose variables (production compose only) ───
POSTGRES_USER=orderhub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=orderhub_prod
IMAGE_TAG=staging-COMMIT_SHA
