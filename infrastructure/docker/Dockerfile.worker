# ── Stage 1: Dependencies ─────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.14.2 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/worker/package.json ./apps/worker/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/

RUN pnpm install --frozen-lockfile --prod=false

# ── Stage 2: Build ────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.14.2 --activate

COPY --from=deps /app/node_modules ./node_modules
# pnpm does not hoist workspace-package-local binaries to root node_modules/.bin.
# Each package whose build script uses a binary (prisma, tsc) must have its own
# node_modules copied explicitly from the deps stage.
COPY --from=deps /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules

COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker

RUN pnpm --filter @orderhub/database db:generate
# Compile packages/database/src/index.ts → dist/ so downstream imports resolve
# to ../generated/prisma (the freshly generated client), not @prisma/client stub.
RUN pnpm --filter @orderhub/database build
RUN pnpm --filter @orderhub/shared build
RUN pnpm --filter @orderhub/worker build

# ── Stage 3: Production ───────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache dumb-init && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

# Preserve apps/worker/ path so Node.js module resolution traverses up through
# apps/worker/node_modules/ for pnpm-linked deps (e.g. reflect-metadata) that
# are symlinked there but not hoisted to root node_modules in a partial install.
COPY --from=builder --chown=nestjs:nodejs /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=nestjs:nodejs /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/packages ./packages

# Startup script: validates env then starts node
COPY --chown=nestjs:nodejs scripts/start-worker.sh ./scripts/start-worker.sh
RUN chmod +x ./scripts/start-worker.sh

USER nestjs

# dumb-init ensures signals (SIGTERM) propagate to the Node process so
# graceful shutdown hooks fire during rolling deploys.
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["./scripts/start-worker.sh"]
